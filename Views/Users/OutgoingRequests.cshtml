@model List<okem_social.Models.User>
@{
    var target = (okem_social.Models.User)ViewBag.Target;
    ViewData["Title"] = $"Lời mời kết bạn đã gửi của {target.FullName}";
}

<div class="mx-auto max-w-4xl space-y-6 py-4">
    <!-- Header Navigation -->
    <div>
        <a asp-action="Search"
           class="inline-flex items-center gap-2 text-xs font-bold text-slate-500 transition-colors hover:text-slate-900" dark:text-slate-400 dark:text-slate-100>
            <i class="fa-solid fa-arrow-left text-[11px]"></i>
            <span>Quay lại mạng lưới</span>
        </a>

        <div class="mt-4 flex flex-col items-start justify-between gap-2 sm:flex-row sm:items-center">
            <div>
                <h1 class="font-heading text-2xl font-extrabold tracking-tight text-slate-900 sm:text-3xl" dark:text-slate-100>
                    Lời mời đã gửi
                </h1>
                <p class="mt-1 text-sm font-medium text-slate-500" dark:text-slate-400>
                    Danh sách các lời mời kết bạn bạn đã gửi đang chờ phản hồi
                </p>
            </div>
            <span class="inline-flex items-center rounded-full bg-slate-100 px-3.5 py-1 text-xs font-bold text-slate-700">
                @Model.Count lời mời
            </span>
        </div>
    </div>

    <!-- Content List -->
    @if (Model.Count == 0)
    {
        <div class="rounded-2xl border border-slate-100 bg-white py-16 text-center shadow-card" dark:border-white/10 dark:bg-black>
            <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-slate-100 text-slate-400">
                <i class="fa-regular fa-paper-plane text-2xl"></i>
            </div>
            <h3 class="mt-4 font-heading text-base font-bold text-slate-900" dark:text-slate-100>
                Bạn chưa gửi lời mời nào
            </h3>
            <p class="mt-1 text-sm text-slate-500" dark:text-slate-400>
                Hãy tìm kiếm bạn bè và gửi lời mời kết bạn để mở rộng mạng lưới của bạn.
            </p>
            <div class="mt-6">
                <a asp-action="Search"
                   class="inline-flex items-center gap-2 rounded-full bg-slate-950 px-6 py-2.5 text-xs sm:text-sm font-bold text-white shadow-sm transition-all hover:bg-slate-800 active:scale-95" dark:bg-white dark:text-black>
                    <i class="fa-solid fa-magnifying-glass text-xs"></i>
                    <span>Tìm kiếm bạn bè</span>
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            @foreach (var u in Model)
            {
                var displayName = !string.IsNullOrWhiteSpace(u.FullName) ? u.FullName : u.Email;
                var initial = !string.IsNullOrWhiteSpace(displayName) ? displayName.Trim()[0].ToString().ToUpper() : "U";

                <div class="flex flex-col justify-between rounded-2xl border border-slate-100 bg-white p-5 shadow-card transition-all hover:border-slate-200 hover:shadow-lift" dark:border-white/10 dark:bg-black>
                    <!-- User Info -->
                    <div class="flex items-start gap-3.5">
                        @if (!string.IsNullOrEmpty(u.AvatarUrl))
                        {
                            <img src="@u.AvatarUrl" alt="@displayName" class="h-12 w-12 shrink-0 rounded-full object-cover shadow-sm" />
                        }
                        else
                        {
                            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-slate-900 to-slate-700 text-sm font-bold text-white shadow-sm">
                                @initial
                            </div>
                        }
                        <div class="min-w-0 flex-1">
                            <a asp-action="Details" asp-route-id="@u.Id" class="block truncate font-heading text-base font-bold text-slate-900 transition-colors hover:text-slate-700" dark:text-slate-100>
                                @displayName
                            </a>
                            <p class="mt-0.5 truncate text-xs text-slate-500" dark:text-slate-400>
                                @u.Email
                            </p>
                            @if (!string.IsNullOrWhiteSpace(u.Nickname))
                            {
                                <p class="mt-0.5 text-xs font-medium text-slate-400">
                                    &#64;@u.Nickname
                                </p>
                            }
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(u.Bio))
                    {
                        <p class="mt-3 line-clamp-2 rounded-xl bg-slate-50 p-2.5 text-xs text-slate-600" dark:text-slate-400 dark:bg-neutral-900>
                            @u.Bio
                        </p>
                    }

                    <!-- Actions -->
                    <div class="mt-5 flex items-center justify-between gap-2 border-t border-slate-100 pt-4" dark:border-white/10>
                        <a asp-action="Details"
                           asp-route-id="@u.Id"
                           class="inline-flex items-center gap-1.5 rounded-full border border-slate-200 bg-white px-3.5 py-1.5 text-xs font-bold text-slate-700 transition-colors hover:border-slate-300 hover:bg-slate-50" dark:hover:bg-white/10 dark:border-white/10 dark:bg-neutral-900 dark:bg-black>
                            <i class="fa-regular fa-user text-[11px]"></i>
                            <span>Hồ sơ</span>
                        </a>

                        <form method="post" asp-action="Cancel" asp-route-id="@u.Id" class="inline">
                            @Html.AntiForgeryToken()
                            <button type="submit"
                                    class="inline-flex items-center gap-1.5 rounded-full border border-slate-200 bg-white px-4 py-1.5 text-xs font-bold text-slate-700 transition-all hover:border-red-200 hover:bg-red-50 hover:text-red-600" dark:border-white/10 dark:bg-black>
                                <i class="fa-solid fa-xmark text-[11px]"></i>
                                <span>Hủy lời mời</span>
                            </button>
                        </form>
                    </div>
                </div>
            }
        </div>
    }
</div>
