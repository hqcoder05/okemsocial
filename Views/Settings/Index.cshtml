@{
    ViewData["Title"] = "Cài đặt";
}

<div class="mx-auto max-w-6xl space-y-6 py-4">
    <!-- Header -->
    <div>
        <h1 class="font-heading text-2xl font-extrabold tracking-tight text-slate-900 sm:text-3xl" dark:text-slate-100>
            Cài đặt
        </h1>
        <p class="mt-1 text-sm font-medium text-slate-500" dark:text-slate-400>
            Quản lý thông tin tài khoản, bảo mật và tùy chọn thông báo của bạn
        </p>
    </div>

    <!-- Main Two-Column Layout -->
    <div class="grid grid-cols-1 gap-6 md:grid-cols-12">
        <!-- Left Sidebar Navigation -->
        <div class="md:col-span-4 lg:col-span-3">
            <div class="sticky top-20 rounded-2xl border border-slate-100 bg-white p-2 shadow-card" dark:border-white/10 dark:bg-black>
                <nav class="space-y-1" id="settings-nav">
                    <button type="button"
                            id="tab-btn-account"
                            onclick="showSettingsTab('account')"
                            class="flex w-full items-center gap-3 rounded-xl bg-slate-950 px-4 py-3 text-left text-sm font-bold text-white shadow-sm transition-all" dark:bg-white dark:text-black>
                        <i class="fa-regular fa-user w-4 text-center text-xs"></i>
                        <span>Tài khoản</span>
                    </button>
                    <button type="button"
                            id="tab-btn-security"
                            onclick="showSettingsTab('security')"
                            class="flex w-full items-center gap-3 rounded-xl px-4 py-3 text-left text-sm font-semibold text-slate-600 transition-all hover:bg-slate-50 hover:text-slate-900" dark:hover:bg-white/10 dark:text-slate-400 dark:text-slate-100 dark:bg-neutral-900>
                        <i class="fa-solid fa-shield-halved w-4 text-center text-xs text-slate-400"></i>
                        <span>Bảo mật</span>
                    </button>
                    <button type="button"
                            id="tab-btn-notifications"
                            onclick="showSettingsTab('notifications')"
                            class="flex w-full items-center gap-3 rounded-xl px-4 py-3 text-left text-sm font-semibold text-slate-600 transition-all hover:bg-slate-50 hover:text-slate-900" dark:hover:bg-white/10 dark:text-slate-400 dark:text-slate-100 dark:bg-neutral-900>
                        <i class="fa-regular fa-bell w-4 text-center text-xs text-slate-400"></i>
                        <span>Thông báo</span>
                    </button>
                </nav>
            </div>
        </div>

        <!-- Right Content Area -->
        <div class="space-y-6 md:col-span-8 lg:col-span-9">

            <!-- TAB 1: TÀI KHOẢN -->
            <div id="tab-pane-account" class="space-y-6">
                <div class="rounded-2xl border border-slate-100 bg-white p-6 shadow-card sm:p-8" dark:border-white/10 dark:bg-black>
                    <div class="flex flex-col justify-between gap-2 border-b border-slate-100 pb-6 sm:flex-row sm:items-center" dark:border-white/10>
                        <div>
                            <h2 class="font-heading text-lg font-bold text-slate-900" dark:text-slate-100>
                                Cài đặt tài khoản
                            </h2>
                            <p class="mt-0.5 text-xs text-slate-500" dark:text-slate-400>
                                Quản lý thông tin hiển thị cơ bản của bạn trên Okem
                            </p>
                        </div>
                        <span class="inline-flex w-fit items-center rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-600" dark:text-slate-400 id="settings-email-label"></span>
                    </div>

                    <!-- PROFILE FORM -->
                    <form id="settings-profile-form" class="mt-6 space-y-5">
                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">
                                Họ và tên
                            </label>
                            <input type="text"
                                   id="settings-fullname"
                                   name="fullName"
                                   placeholder="Nhập họ tên hiển thị"
                                   required
                                   minlength="2"
                                   class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm font-medium text-slate-900 outline-none transition-all focus:border-slate-900 focus:bg-white" dark:text-slate-100 dark:border-white/10 dark:bg-neutral-900 dark:bg-black />
                        </div>

                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">
                                Biệt danh (Nickname)
                            </label>
                            <div class="relative flex items-center">
                                <span class="absolute left-4 text-sm font-semibold text-slate-400">&#64;</span>
                                <input type="text"
                                       id="settings-nickname"
                                       name="nickname"
                                       placeholder="username"
                                       class="w-full rounded-xl border border-slate-200 bg-slate-50 py-2.5 pl-8 pr-4 text-sm font-medium text-slate-900 outline-none transition-all focus:border-slate-900 focus:bg-white" dark:text-slate-100 dark:border-white/10 dark:bg-neutral-900 dark:bg-black />
                            </div>
                        </div>

                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">
                                Tiểu sử (Bio)
                            </label>
                            <textarea id="settings-bio"
                                      name="bio"
                                      rows="3"
                                      placeholder="Viết đôi dòng giới thiệu bản thân..."
                                      class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm font-medium text-slate-900 outline-none transition-all focus:border-slate-900 focus:bg-white" dark:text-slate-100 dark:border-white/10 dark:bg-neutral-900 dark:bg-black></textarea>
                        </div>

                        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
                            <div>
                                <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">
                                    Email đăng nhập
                                </label>
                                <input type="email"
                                       id="settings-email"
                                       disabled
                                       class="w-full cursor-not-allowed rounded-xl border border-slate-200 bg-slate-100/80 px-4 py-2.5 text-sm font-medium text-slate-500 outline-none" dark:text-slate-400 dark:border-white/10 />
                                <p class="mt-1.5 text-[11px] text-slate-400">
                                    Email dùng để đăng nhập, không thể thay đổi.
                                </p>
                            </div>

                            <div>
                                <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">
                                    Ngày tham gia
                                </label>
                                <input type="text"
                                       id="settings-created-at"
                                       disabled
                                       class="w-full cursor-not-allowed rounded-xl border border-slate-200 bg-slate-100/80 px-4 py-2.5 text-sm font-medium text-slate-500 outline-none" dark:text-slate-400 dark:border-white/10 />
                            </div>
                        </div>

                        <div class="flex flex-col-reverse items-stretch justify-between gap-4 border-t border-slate-100 pt-6 sm:flex-row sm:items-center" dark:border-white/10>
                            <div class="text-xs font-semibold" id="settings-message"></div>
                            <button type="submit"
                                    id="settings-submit-btn"
                                    class="inline-flex items-center justify-center gap-2 rounded-full bg-slate-950 px-6 py-2.5 text-sm font-bold text-white shadow-sm transition-all hover:bg-slate-800 active:scale-95" dark:bg-white dark:text-black>
                                <i class="fa-solid fa-floppy-disk text-xs"></i>
                                <span>Lưu thay đổi</span>
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- TAB 2: BẢO MẬT -->
            <div id="tab-pane-security" class="hidden space-y-6">
                <div class="rounded-2xl border border-slate-100 bg-white p-6 shadow-card sm:p-8" dark:border-white/10 dark:bg-black>
                    <div class="border-b border-slate-100 pb-6" dark:border-white/10>
                        <h2 class="font-heading text-lg font-bold text-slate-900" dark:text-slate-100>
                            Bảo mật & Quyền riêng tư
                        </h2>
                        <p class="mt-0.5 text-xs text-slate-500" dark:text-slate-400>
                            Tăng cường bảo vệ tài khoản và quản lý thông tin bảo mật của bạn
                        </p>
                    </div>

                    <div class="mt-6 divide-y divide-slate-100 space-y-6">
                        <!-- Toggle items -->
                        <div class="flex items-center justify-between pt-2">
                            <div>
                                <h3 class="text-sm font-bold text-slate-900" dark:text-slate-100>Hiển thị trạng thái hoạt động</h3>
                                <p class="text-xs text-slate-500" dark:text-slate-400>Cho phép bạn bè nhìn thấy khi bạn đang trực tuyến trên Okem</p>
                            </div>
                            <label class="relative inline-flex cursor-pointer items-center">
                                <input type="checkbox" checked class="peer sr-only" />
                                <div class="h-6 w-11 rounded-full bg-slate-200 transition-colors after:absolute after:left-[2px] after:top-[2px] after:h-5 after:w-5 after:rounded-full after:border after:border-slate-300 after:bg-white after:transition-all after:content-[''] peer-checked:bg-slate-950 peer-checked:after:translate-x-full peer-checked:after:border-white peer-focus:outline-none" dark:bg-black></div>
                            </label>
                        </div>

                        <div class="flex items-center justify-between pt-6">
                            <div>
                                <h3 class="text-sm font-bold text-slate-900" dark:text-slate-100>Nhận tin nhắn từ người lạ</h3>
                                <p class="text-xs text-slate-500" dark:text-slate-400>Cho phép người không nằm trong danh sách bạn bè gửi tin nhắn cho bạn</p>
                            </div>
                            <label class="relative inline-flex cursor-pointer items-center">
                                <input type="checkbox" checked class="peer sr-only" />
                                <div class="h-6 w-11 rounded-full bg-slate-200 transition-colors after:absolute after:left-[2px] after:top-[2px] after:h-5 after:w-5 after:rounded-full after:border after:border-slate-300 after:bg-white after:transition-all after:content-[''] peer-checked:bg-slate-950 peer-checked:after:translate-x-full peer-checked:after:border-white peer-focus:outline-none" dark:bg-black></div>
                            </label>
                        </div>

                        <div class="flex items-center justify-between pt-6">
                            <div>
                                <h3 class="text-sm font-bold text-slate-900" dark:text-slate-100>Xác thực 2 yếu tố (2FA)</h3>
                                <p class="text-xs text-slate-500" dark:text-slate-400>Yêu cầu mã xác thực khi đăng nhập từ thiết bị lạ</p>
                            </div>
                            <label class="relative inline-flex cursor-pointer items-center">
                                <input type="checkbox" class="peer sr-only" />
                                <div class="h-6 w-11 rounded-full bg-slate-200 transition-colors after:absolute after:left-[2px] after:top-[2px] after:h-5 after:w-5 after:rounded-full after:border after:border-slate-300 after:bg-white after:transition-all after:content-[''] peer-checked:bg-slate-950 peer-checked:after:translate-x-full peer-checked:after:border-white peer-focus:outline-none" dark:bg-black></div>
                            </label>
                        </div>
                    </div>
                </div>
            </div>

            <!-- TAB 3: THÔNG BÁO -->
            <div id="tab-pane-notifications" class="hidden space-y-6">
                <div class="rounded-2xl border border-slate-100 bg-white p-6 shadow-card sm:p-8" dark:border-white/10 dark:bg-black>
                    <div class="border-b border-slate-100 pb-6" dark:border-white/10>
                        <h2 class="font-heading text-lg font-bold text-slate-900" dark:text-slate-100>
                            Cài đặt thông báo
                        </h2>
                        <p class="mt-0.5 text-xs text-slate-500" dark:text-slate-400>
                            Tùy chỉnh thông báo đẩy và email bạn muốn nhận từ hệ thống
                        </p>
                    </div>

                    <div class="mt-6 divide-y divide-slate-100 space-y-6">
                        <div class="flex items-center justify-between pt-2">
                            <div>
                                <h3 class="text-sm font-bold text-slate-900" dark:text-slate-100>Tin nhắn mới</h3>
                                <p class="text-xs text-slate-500" dark:text-slate-400>Nhận thông báo tức thì khi có ai đó nhắn tin cho bạn</p>
                            </div>
                            <label class="relative inline-flex cursor-pointer items-center">
                                <input type="checkbox" checked class="peer sr-only" />
                                <div class="h-6 w-11 rounded-full bg-slate-200 transition-colors after:absolute after:left-[2px] after:top-[2px] after:h-5 after:w-5 after:rounded-full after:border after:border-slate-300 after:bg-white after:transition-all after:content-[''] peer-checked:bg-slate-950 peer-checked:after:translate-x-full peer-checked:after:border-white peer-focus:outline-none" dark:bg-black></div>
                            </label>
                        </div>

                        <div class="flex items-center justify-between pt-6">
                            <div>
                                <h3 class="text-sm font-bold text-slate-900" dark:text-slate-100>Lời mời kết bạn</h3>
                                <p class="text-xs text-slate-500" dark:text-slate-400>Thông báo khi có người dùng mới gửi lời mời kết bạn</p>
                            </div>
                            <label class="relative inline-flex cursor-pointer items-center">
                                <input type="checkbox" checked class="peer sr-only" />
                                <div class="h-6 w-11 rounded-full bg-slate-200 transition-colors after:absolute after:left-[2px] after:top-[2px] after:h-5 after:w-5 after:rounded-full after:border after:border-slate-300 after:bg-white after:transition-all after:content-[''] peer-checked:bg-slate-950 peer-checked:after:translate-x-full peer-checked:after:border-white peer-focus:outline-none" dark:bg-black></div>
                            </label>
                        </div>

                        <div class="flex items-center justify-between pt-6">
                            <div>
                                <h3 class="text-sm font-bold text-slate-900" dark:text-slate-100>Tương tác bài viết</h3>
                                <p class="text-xs text-slate-500" dark:text-slate-400>Thông báo khi có người thích hoặc bình luận bài viết của bạn</p>
                            </div>
                            <label class="relative inline-flex cursor-pointer items-center">
                                <input type="checkbox" checked class="peer sr-only" />
                                <div class="h-6 w-11 rounded-full bg-slate-200 transition-colors after:absolute after:left-[2px] after:top-[2px] after:h-5 after:w-5 after:rounded-full after:border after:border-slate-300 after:bg-white after:transition-all after:content-[''] peer-checked:bg-slate-950 peer-checked:after:translate-x-full peer-checked:after:border-white peer-focus:outline-none" dark:bg-black></div>
                            </label>
                        </div>

                        <div class="flex items-center justify-between pt-6">
                            <div>
                                <h3 class="text-sm font-bold text-slate-900" dark:text-slate-100>Thông báo qua Email</h3>
                                <p class="text-xs text-slate-500" dark:text-slate-400>Nhận bản tóm tắt các hoạt động nổi bật hàng tuần</p>
                            </div>
                            <label class="relative inline-flex cursor-pointer items-center">
                                <input type="checkbox" class="peer sr-only" />
                                <div class="h-6 w-11 rounded-full bg-slate-200 transition-colors after:absolute after:left-[2px] after:top-[2px] after:h-5 after:w-5 after:rounded-full after:border after:border-slate-300 after:bg-white after:transition-all after:content-[''] peer-checked:bg-slate-950 peer-checked:after:translate-x-full peer-checked:after:border-white peer-focus:outline-none" dark:bg-black></div>
                            </label>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            loadSettingsProfile();

            const form = document.getElementById("settings-profile-form");
            if (form) {
                form.addEventListener("submit", async function (e) {
                    e.preventDefault();
                    await submitSettingsProfile();
                });
            }
        });

        function showSettingsTab(tabName) {
            const tabs = ['account', 'security', 'notifications'];
            tabs.forEach(t => {
                const pane = document.getElementById(`tab-pane-${t}`);
                const btn = document.getElementById(`tab-btn-${t}`);
                if (pane) {
                    if (t === tabName) {
                        pane.classList.remove('hidden');
                    } else {
                        pane.classList.add('hidden');
                    }
                }
                if (btn) {
                    if (t === tabName) {
                        btn.className = "flex w-full items-center gap-3 rounded-xl bg-slate-950 px-4 py-3 text-left text-sm font-bold text-white shadow-sm transition-all";
                        const icon = btn.querySelector('i');
                        if (icon) icon.className = icon.className.replace('text-slate-400', 'text-white');
                    } else {
                        btn.className = "flex w-full items-center gap-3 rounded-xl px-4 py-3 text-left text-sm font-semibold text-slate-600 transition-all hover:bg-slate-50 hover:text-slate-900";
                        const icon = btn.querySelector('i');
                        if (icon) icon.className = icon.className.replace('text-white', 'text-slate-400');
                    }
                }
            });
        }

        async function loadSettingsProfile() {
            const msg = document.getElementById("settings-message");
            if (msg) {
                msg.textContent = "Đang tải dữ liệu...";
                msg.className = "text-xs font-semibold text-slate-400";
            }

            try {
                const res = await fetch("/api/settings/me", {
                    headers: {
                        "X-Requested-With": "XMLHttpRequest"
                    }
                });

                if (res.status === 401) {
                    if (msg) {
                        msg.textContent = "Bạn cần đăng nhập để xem trang cài đặt.";
                        msg.className = "text-xs font-semibold text-red-500";
                    }
                    return;
                }

                if (!res.ok) {
                    throw new Error("Không thể tải dữ liệu.");
                }

                const data = await res.json();

                const fullnameInput = document.getElementById("settings-fullname");
                const nicknameInput = document.getElementById("settings-nickname");
                const bioInput = document.getElementById("settings-bio");
                const emailInput = document.getElementById("settings-email");
                const createdAtInput = document.getElementById("settings-created-at");
                const emailLabel = document.getElementById("settings-email-label");

                if (fullnameInput) fullnameInput.value = data.fullName || "";
                if (nicknameInput) nicknameInput.value = data.nickname || "";
                if (bioInput) bioInput.value = data.bio || "";
                if (emailInput) emailInput.value = data.email || "";
                if (emailLabel) emailLabel.textContent = data.email || "";

                if (createdAtInput && data.createdAt) {
                    const d = new Date(data.createdAt);
                    createdAtInput.value = d.toLocaleDateString("vi-VN");
                }

                if (msg) msg.textContent = "";
            } catch (err) {
                console.error("loadSettingsProfile error", err);
                if (msg) {
                    msg.textContent = "Lỗi khi tải dữ liệu cài đặt.";
                    msg.className = "text-xs font-semibold text-red-500";
                }
            }
        }

        async function submitSettingsProfile() {
            const msg = document.getElementById("settings-message");
            const fullnameInput = document.getElementById("settings-fullname");
            const nicknameInput = document.getElementById("settings-nickname");
            const bioInput = document.getElementById("settings-bio");
            const submitBtn = document.getElementById("settings-submit-btn");

            if (!fullnameInput) return;

            const fullName = fullnameInput.value.trim();
            const nickname = nicknameInput ? nicknameInput.value.trim() : null;
            const bio = bioInput ? bioInput.value.trim() : null;

            if (fullName.length < 2) {
                if (msg) {
                    msg.textContent = "Họ và tên phải có ít nhất 2 ký tự.";
                    msg.className = "text-xs font-semibold text-red-500";
                }
                return;
            }

            try {
                if (msg) {
                    msg.textContent = "Đang lưu thay đổi...";
                    msg.className = "text-xs font-semibold text-slate-500";
                }
                if (submitBtn) submitBtn.disabled = true;

                const res = await fetch("/api/settings/me", {
                    method: "PUT",
                    headers: {
                        "Content-Type": "application/json",
                        "X-Requested-With": "XMLHttpRequest"
                    },
                    body: JSON.stringify({
                        fullName: fullName,
                        nickname: nickname || null,
                        bio: bio || null
                    })
                });

                if (!res.ok) {
                    let txt = "Lưu thất bại.";
                    try {
                        const err = await res.json();
                        if (err && err.message) txt = err.message;
                    } catch { }
                    throw new Error(txt);
                }

                const data = await res.json();

                if (msg) {
                    msg.textContent = "Đã cập nhật thông tin thành công.";
                    msg.className = "text-xs font-semibold text-emerald-600";
                }
            } catch (err) {
                console.error("submitSettingsProfile error", err);
                if (msg) {
                    msg.textContent = err.message || "Có lỗi xảy ra khi lưu.";
                    msg.className = "text-xs font-semibold text-red-500";
                }
            } finally {
                if (submitBtn) submitBtn.disabled = false;
            }
        }
    </script>
}
