@{
    ViewData["Title"] = "Thông báo";
}

<div class="mx-auto max-w-4xl space-y-6 py-4">
    <!-- Page Header -->
    <div class="flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-center">
        <div>
            <h1 class="font-heading text-2xl font-extrabold tracking-tight text-slate-900 sm:text-3xl" dark:text-slate-100>
                Thông báo
            </h1>
            <p class="mt-1 text-sm font-medium text-slate-500" dark:text-slate-400>
                Cập nhật các hoạt động và tương tác mới nhất của bạn
            </p>
        </div>

        <button type="button"
                onclick="markAllAsRead()"
                class="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-white px-4 py-2 text-xs sm:text-sm font-bold text-slate-700 shadow-sm transition-all hover:border-slate-300 hover:bg-slate-50 hover:text-slate-900 active:scale-95" dark:hover:bg-white/10 dark:text-slate-100 dark:border-white/10 dark:bg-neutral-900 dark:bg-black>
            <i class="fa-solid fa-check-double text-slate-500" dark:text-slate-400></i>
            <span>Đánh dấu tất cả đã đọc</span>
        </button>
    </div>

    <!-- Filter Tabs -->
    <div class="flex">
        <div class="inline-flex rounded-full border border-slate-200 bg-white p-1 shadow-card" dark:border-white/10 dark:bg-black role="tablist">
            <button type="button"
                    id="tab-all-btn"
                    onclick="switchNotifTab('all')"
                    class="inline-flex items-center gap-2 rounded-full bg-slate-950 px-5 py-2 text-xs sm:text-sm font-bold text-white shadow-sm transition-all" dark:bg-white dark:text-black>
                <i class="fa-solid fa-inbox text-xs"></i>
                <span>Tất cả</span>
            </button>
            <button type="button"
                    id="tab-unread-btn"
                    onclick="switchNotifTab('unread')"
                    class="inline-flex items-center gap-2 rounded-full px-5 py-2 text-xs sm:text-sm font-semibold text-slate-600 transition-all hover:bg-slate-50 hover:text-slate-900" dark:hover:bg-white/10 dark:text-slate-400 dark:text-slate-100 dark:bg-neutral-900>
                <i class="fa-solid fa-circle text-[8px]"></i>
                <span>Chưa đọc</span>
            </button>
            <button type="button"
                    id="tab-mentions-btn"
                    onclick="switchNotifTab('mentions')"
                    class="inline-flex items-center gap-2 rounded-full px-5 py-2 text-xs sm:text-sm font-semibold text-slate-600 transition-all hover:bg-slate-50 hover:text-slate-900" dark:hover:bg-white/10 dark:text-slate-400 dark:text-slate-100 dark:bg-neutral-900>
                <i class="fa-solid fa-at text-xs"></i>
                <span>Đề cập</span>
            </button>
        </div>
    </div>

    <!-- Notification Lists by Tab -->
    <div>
        <!-- TAB: TẤT CẢ -->
        <div id="pane-all">
            <div id="notificationsAll" class="space-y-3"></div>

            <div id="emptyAllState" class="hidden rounded-2xl border border-slate-100 bg-white py-16 text-center shadow-card" dark:border-white/10 dark:bg-black>
                <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-slate-100 text-slate-400">
                    <i class="fa-regular fa-bell-slash text-2xl"></i>
                </div>
                <h3 class="mt-4 font-heading text-base font-bold text-slate-900" dark:text-slate-100>
                    Không có thông báo nào
                </h3>
                <p class="mt-1 text-sm text-slate-500" dark:text-slate-400>
                    Bạn chưa có thông báo hoạt động nào tại thời điểm này.
                </p>
            </div>
        </div>

        <!-- TAB: CHƯA ĐỌC -->
        <div id="pane-unread" class="hidden">
            <div id="notificationsUnread" class="space-y-3"></div>

            <div id="emptyUnreadState" class="hidden rounded-2xl border border-slate-100 bg-white py-16 text-center shadow-card" dark:border-white/10 dark:bg-black>
                <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-emerald-50 text-emerald-600">
                    <i class="fa-solid fa-check text-2xl"></i>
                </div>
                <h3 class="mt-4 font-heading text-base font-bold text-slate-900" dark:text-slate-100>
                    Bạn đã đọc hết thông báo
                </h3>
                <p class="mt-1 text-sm text-slate-500" dark:text-slate-400>
                    Tuyệt vời! Không có thông báo chưa đọc nào đang chờ bạn.
                </p>
            </div>
        </div>

        <!-- TAB: ĐỀ CẬP -->
        <div id="pane-mentions" class="hidden">
            <div id="notificationsMentions" class="space-y-3"></div>

            <div id="emptyMentionsState" class="hidden rounded-2xl border border-slate-100 bg-white py-16 text-center shadow-card" dark:border-white/10 dark:bg-black>
                <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-slate-100 text-slate-400">
                    <i class="fa-solid fa-at text-2xl"></i>
                </div>
                <h3 class="mt-4 font-heading text-base font-bold text-slate-900" dark:text-slate-100>
                    Chưa có lượt đề cập nào
                </h3>
                <p class="mt-1 text-sm text-slate-500" dark:text-slate-400>
                    Khi có ai đó nhắc đến bạn trong bài viết hoặc bình luận, thông báo sẽ hiển thị ở đây.
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>

    <script>
        let notifications = [];
        let notiConn = null;
        let currentTab = 'all';

        document.addEventListener("DOMContentLoaded", async function () {
            await loadNotifications();
            await connectNotificationHub();
        });

        function switchNotifTab(tabName) {
            currentTab = tabName;
            const tabs = ['all', 'unread', 'mentions'];

            tabs.forEach(t => {
                const pane = document.getElementById(`pane-${t}`);
                const btn = document.getElementById(`tab-${t}-btn`);

                if (pane) {
                    if (t === tabName) {
                        pane.classList.remove('hidden');
                    } else {
                        pane.classList.add('hidden');
                    }
                }

                if (btn) {
                    if (t === tabName) {
                        btn.className = "inline-flex items-center gap-2 rounded-full bg-slate-950 px-5 py-2 text-xs sm:text-sm font-bold text-white shadow-sm transition-all";
                    } else {
                        btn.className = "inline-flex items-center gap-2 rounded-full px-5 py-2 text-xs sm:text-sm font-semibold text-slate-600 transition-all hover:bg-slate-50 hover:text-slate-900";
                    }
                }
            });
        }

        async function connectNotificationHub() {
            try {
                notiConn = new signalR.HubConnectionBuilder()
                    .withUrl("/hubs/notifications")
                    .withAutomaticReconnect()
                    .build();

                notiConn.on("NotificationReceived", n => {
                    notifications.unshift(n);
                    renderAllTabs();
                });

                await notiConn.start();
                console.log("NotificationHub connected");
            } catch (e) {
                console.error("NotificationHub error", e);
            }
        }

        async function loadNotifications() {
            try {
                const res = await fetch("/api/notifications", {
                    headers: { "X-Requested-With": "XMLHttpRequest" }
                });

                if (!res.ok) {
                    throw new Error("Failed to load notifications");
                }

                notifications = (await res.json()) ?? [];
                renderAllTabs();
            } catch (e) {
                console.error(e);
            }
        }

        function renderAllTabs() {
            const allContainer = document.getElementById("notificationsAll");
            const unreadContainer = document.getElementById("notificationsUnread");
            const mentionsContainer = document.getElementById("notificationsMentions");

            const emptyAll = document.getElementById("emptyAllState");
            const emptyUnread = document.getElementById("emptyUnreadState");
            const emptyMentions = document.getElementById("emptyMentionsState");

            if (allContainer) allContainer.innerHTML = "";
            if (unreadContainer) unreadContainer.innerHTML = "";
            if (mentionsContainer) mentionsContainer.innerHTML = "";

            const listAll = notifications.slice().sort((a, b) => new Date(b.createdAt) - new Date(a.createdAt));
            const listUnread = listAll.filter(n => !n.isRead && !n.read);
            const listMentions = listAll.filter(n => (n.type || "").toLowerCase() === "mention");

            renderNotificationList(listAll, allContainer, emptyAll);
            renderNotificationList(listUnread, unreadContainer, emptyUnread);
            renderNotificationList(listMentions, mentionsContainer, emptyMentions);
        }

        function renderNotificationList(list, container, emptyElement) {
            if (!container || !emptyElement) return;

            if (!list || list.length === 0) {
                emptyElement.classList.remove("hidden");
                return;
            }

            emptyElement.classList.add("hidden");

            list.forEach(n => {
                const isRead = !!(n.isRead || n.read);
                const card = document.createElement("div");
                card.className = "flex items-start justify-between gap-4 rounded-2xl border p-4 sm:p-5 transition-all shadow-card cursor-pointer " +
                    (isRead
                        ? "border-slate-100 bg-white hover:border-slate-300 hover:shadow-lift"
                        : "border-blue-100 bg-blue-50/50 hover:bg-blue-50/80 hover:border-blue-200");

                const leftWrap = document.createElement("div");
                leftWrap.className = "flex items-start gap-3.5 min-w-0 flex-1";

                // Icon / Avatar Circle
                const avatar = document.createElement("div");
                avatar.className = `flex h-11 w-11 shrink-0 items-center justify-center rounded-full text-white text-sm font-bold shadow-sm ${getAvatarBg(n.type)}`;
                avatar.innerHTML = getIconHtml(n.type);

                // Body
                const body = document.createElement("div");
                body.className = "min-w-0 flex-1";

                const titleRow = document.createElement("div");
                titleRow.className = "flex items-center flex-wrap gap-2";

                const titleSpan = document.createElement("span");
                titleSpan.className = "font-heading text-sm font-bold text-slate-900";
                titleSpan.textContent = n.title || "Thông báo";
                titleRow.appendChild(titleSpan);

                if (!isRead) {
                    const badge = document.createElement("span");
                    badge.className = "inline-flex items-center rounded-full bg-blue-100 px-2 py-0.5 text-[10px] font-bold text-blue-700";
                    badge.textContent = "Mới";
                    titleRow.appendChild(badge);
                }

                const timeRow = document.createElement("div");
                timeRow.className = "flex items-center gap-1.5 text-xs text-slate-400 mt-1";
                timeRow.innerHTML = `<i class="fa-regular fa-clock text-[10px]"></i><span>${formatDateTime(n.createdAt)}</span>`;

                body.appendChild(titleRow);
                body.appendChild(timeRow);

                if (n.content) {
                    const preview = document.createElement("div");
                    preview.className = "mt-2.5 rounded-xl border border-slate-100 bg-slate-50/80 p-3 text-xs text-slate-600 font-medium leading-relaxed";
                    preview.textContent = n.content;
                    body.appendChild(preview);
                }

                leftWrap.appendChild(avatar);
                leftWrap.appendChild(body);

                // Right action (mark read button)
                const rightAction = document.createElement("div");
                rightAction.className = "shrink-0";

                if (!isRead) {
                    const btnMark = document.createElement("button");
                    btnMark.type = "button";
                    btnMark.title = "Đánh dấu đã đọc";
                    btnMark.className = "flex h-8 w-8 items-center justify-center rounded-full text-slate-400 hover:bg-slate-100 hover:text-slate-700 transition-colors";
                    btnMark.innerHTML = '<i class="fa-solid fa-check text-xs"></i>';
                    btnMark.addEventListener("click", function (ev) {
                        ev.preventDefault();
                        ev.stopPropagation();
                        markAsRead(n.id);
                    });
                    rightAction.appendChild(btnMark);
                }

                card.appendChild(leftWrap);
                card.appendChild(rightAction);

                card.addEventListener("click", function () {
                    handleClickNotification(n);
                });

                container.appendChild(card);
            });
        }

        function getAvatarBg(type) {
            const t = (type || "").toLowerCase();
            if (t.includes("friend")) return "bg-gradient-to-br from-emerald-600 to-teal-500";
            if (t.includes("message")) return "bg-gradient-to-br from-blue-600 to-indigo-600";
            if (t.includes("mention")) return "bg-gradient-to-br from-purple-600 to-pink-600";
            return "bg-gradient-to-br from-slate-900 to-slate-700";
        }

        function getIconHtml(type) {
            const t = (type || "").toLowerCase();
            if (t.includes("friend")) return '<i class="fa-solid fa-user-plus text-xs"></i>';
            if (t.includes("message")) return '<i class="fa-solid fa-message text-xs"></i>';
            if (t.includes("mention")) return '<i class="fa-solid fa-at text-xs"></i>';
            return '<i class="fa-solid fa-bell text-xs"></i>';
        }

        function formatDateTime(dtStr) {
            if (!dtStr) return "";
            const d = new Date(dtStr);
            if (isNaN(d.getTime())) return dtStr;
            return d.toLocaleString("vi-VN");
        }

        async function markAsRead(id) {
            try {
                const res = await fetch(`/api/notifications/${id}/read`, {
                    method: "POST",
                    headers: {
                        "X-Requested-With": "XMLHttpRequest"
                    }
                });

                if (!res.ok) {
                    throw new Error("Failed to mark as read");
                }

                // Update local array and re-render
                const item = notifications.find(x => x.id === id);
                if (item) {
                    item.isRead = true;
                    item.read = true;
                }
                renderAllTabs();
            } catch (e) {
                console.error(e);
            }
        }

        async function markAllAsRead() {
            try {
                const res = await fetch("/api/notifications/read-all", {
                    method: "POST",
                    headers: {
                        "X-Requested-With": "XMLHttpRequest"
                    }
                });

                if (!res.ok) {
                    throw new Error("Failed to mark all as read");
                }

                notifications.forEach(n => {
                    n.isRead = true;
                    n.read = true;
                });
                renderAllTabs();
            } catch (e) {
                console.error(e);
            }
        }

        function handleClickNotification(n) {
            markAsRead(n.id);
            if (n.url) {
                window.location.href = n.url;
            }
        }
    </script>
}
