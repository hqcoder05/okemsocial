@{
    ViewData["Title"] = "Đăng ký";
}

<div class="min-h-[calc(100vh-130px)] flex items-center justify-center py-8">
    <div class="w-full max-w-[440px] rounded-2xl border border-slate-100 bg-white p-8 shadow-card" dark:border-white/10 dark:bg-black>
        <!-- Logo & Header -->
        <div class="mb-8 text-center">
            <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-2xl bg-slate-950 text-white text-xl font-black shadow-sm" dark:bg-white dark:text-black>
                L
            </div>
            <h1 class="font-heading text-2xl font-extrabold tracking-tight text-slate-900" dark:text-slate-100>Tạo tài khoản</h1>
            <p class="mt-1.5 text-sm font-medium text-slate-500" dark:text-slate-400>Tham gia kết nối cùng Okem ngay hôm nay</p>
        </div>

        @if (TempData["err"] != null)
        {
            <div class="mb-5 flex items-center gap-2.5 rounded-xl border border-red-200 bg-red-50/80 p-3.5 text-xs font-semibold text-red-600">
                <i class="fa-solid fa-circle-exclamation shrink-0 text-sm"></i>
                <span>@TempData["err"]</span>
            </div>
        }
        @if (TempData["ok"] != null)
        {
            <div class="mb-5 flex items-center gap-2.5 rounded-xl border border-emerald-200 bg-emerald-50/80 p-3.5 text-xs font-semibold text-emerald-600">
                <i class="fa-solid fa-circle-check shrink-0 text-sm"></i>
                <span>@TempData["ok"]</span>
            </div>
        }

        <form asp-action="Register" method="post" class="space-y-4">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-sm text-red-500"></div>

            <!-- FullName -->
            <div>
                <label name="fullName" id="fullName" required class="mb-1.5 block text-[11px] font-bold uppercase tracking-wider text-slate-500" dark:text-slate-400>Tên đầy đủ</label>
                <input name="fullName" id="fullName" required class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-medium text-slate-900 outline-none focus:border-slate-400 focus:bg-white transition-all dark:border-white/10 dark:bg-neutral-900 dark:text-white dark:focus:border-white/30" placeholder="Nguyễn Văn A" required />
                
            </div>

            <!-- Email -->
            <div>
                <label name="email" id="email" required class="mb-1.5 block text-[11px] font-bold uppercase tracking-wider text-slate-500" dark:text-slate-400>Địa chỉ Email</label>
                <input name="email" id="email" required type="email" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-medium text-slate-900 outline-none focus:border-slate-400 focus:bg-white transition-all dark:border-white/10 dark:bg-neutral-900 dark:text-white dark:focus:border-white/30" placeholder="name@example.com" required />
                
            </div>

            <!-- Password -->
            <div>
                <label name="password" id="password" required class="mb-1.5 block text-[11px] font-bold uppercase tracking-wider text-slate-500" dark:text-slate-400>Mật khẩu</label>
                <div class="relative">
                    <input name="password" id="password" required type="password" id="password" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-medium text-slate-900 outline-none focus:border-slate-400 focus:bg-white transition-all dark:border-white/10 dark:bg-neutral-900 dark:text-white dark:focus:border-white/30" placeholder="Tối thiểu 8 ký tự" required />
                    <button type="button" class="toggle-password-btn absolute right-3 top-1/2 -translate-y-1/2 p-2 text-slate-400 hover:text-slate-600 transition-colors" data-target="password">
                        <i class="fa-regular fa-eye"></i>
                    </button>
                </div>
                
            </div>

            <!-- Confirm Password -->
            <div>
                <label name="confirmPassword" id="confirmPassword" required class="mb-1.5 block text-[11px] font-bold uppercase tracking-wider text-slate-500" dark:text-slate-400>Xác nhận mật khẩu</label>
                <div class="relative">
                    <input name="confirmPassword" id="confirmPassword" required type="password" id="confirmPassword" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-medium text-slate-900 outline-none focus:border-slate-400 focus:bg-white transition-all dark:border-white/10 dark:bg-neutral-900 dark:text-white dark:focus:border-white/30" placeholder="••••••••" required />
                    <button type="button" class="toggle-password-btn absolute right-3 top-1/2 -translate-y-1/2 p-2 text-slate-400 hover:text-slate-600 transition-colors" data-target="confirmPassword">
                        <i class="fa-regular fa-eye"></i>
                    </button>
                </div>
                <p id="passwordMatch" class="hidden mt-1.5 text-[11px] font-semibold"></p>
                
            </div>

            <!-- Terms -->
            <div class="flex items-start gap-3 pt-2">
                <input type="checkbox" required class="mt-1 h-4 w-4 rounded border-slate-300 text-slate-900 focus:ring-slate-900" />
                <label class="text-xs text-slate-500" dark:text-slate-400>
                    Tôi đồng ý với <a href="/Home/Terms" class="font-bold text-slate-900 hover:underline" dark:text-white>Điều khoản dịch vụ</a> và <a href="/Home/Privacy" class="font-bold text-slate-900 hover:underline" dark:text-white>Chính sách bảo mật</a>
                </label>
            </div>

            <button type="submit" class="mt-2 flex w-full items-center justify-center gap-2 rounded-full bg-slate-950 py-3.5 text-sm font-bold text-white shadow-sm hover:bg-slate-800 active:scale-95 transition-all dark:bg-white dark:text-black dark:hover:bg-slate-200" dark:bg-black>
                Tạo tài khoản <i class="fa-solid fa-arrow-right text-xs"></i>
            </button>

            <!-- Social Logins -->
            <div class="relative my-6">
                <div class="absolute inset-0 flex items-center"><div class="w-full border-t border-slate-200" dark:border-white/10></div></div>
                <div class="relative flex justify-center text-xs"><span class="bg-white px-3 text-slate-400" dark:bg-black>Hoặc đăng ký bằng</span></div>
            </div>

            <div class="grid grid-cols-2 gap-3">
                <a asp-action="ExternalLogin" asp-route-provider="Google" class="flex h-11 items-center justify-center gap-2.5 rounded-xl border border-slate-200 bg-white text-sm font-bold text-slate-700 hover:bg-slate-50 transition-colors dark:border-white/10 dark:bg-black dark:text-slate-200 dark:hover:bg-white/10">
                    <img src="https://www.google.com/favicon.ico" alt="Google" class="h-4 w-4" /> Google
                </a>
                <a asp-action="ExternalLogin" asp-route-provider="Facebook" class="flex h-11 items-center justify-center gap-2.5 rounded-xl border border-slate-200 bg-white text-sm font-bold text-slate-700 hover:bg-slate-50 transition-colors dark:border-white/10 dark:bg-black dark:text-slate-200 dark:hover:bg-white/10">
                    <i class="fa-brands fa-facebook text-[#1877F2] text-lg"></i> Facebook
                </a>
            </div>

        </form>

        <p class="mt-8 text-center text-sm text-slate-500" dark:text-slate-400>
            Đã có tài khoản? <a asp-action="Login" class="font-bold text-slate-900 hover:underline" dark:text-white>Đăng nhập ngay</a>
        </p>
    </div>
</div>
