@model okem_social.Models.Conversation

@{
    var currentUserId = (int)(ViewBag.CurrentUserId ?? 0);
    var otherMember = Model.Members.FirstOrDefault(m => m.UserId != currentUserId);
    var otherUser = otherMember?.User;
    var otherUserId = otherMember?.UserId ?? 0;
    var otherName = otherUser?.FullName ?? otherUser?.Email ?? "Người dùng";
    var otherMembers = Model.Members
        .Where(m => m.UserId != currentUserId)
        .Select(m => m.User?.FullName ?? m.User?.Email ?? "Người dùng")
        .ToList();
    var title = otherMembers.Any() ? string.Join(", ", otherMembers) : "Đoạn chat";
    var initial = !string.IsNullOrEmpty(otherName) ? otherName.Substring(0, 1).ToUpper() : "U";
}

<div class="chat-root h-full flex flex-col bg-white" dark:bg-black
     data-chat-root="1"
     data-conversation-id="@Model.Id"
     data-current-user-id="@currentUserId"
     data-peer-user-id="@otherUserId">

    <!-- CHAT HEADER -->
    <div class="flex items-center justify-between border-b border-slate-100 px-4 sm:px-6 py-3.5 bg-white shrink-0" dark:border-white/10 dark:bg-black>
        <div class="flex items-center gap-3 min-w-0">
            <!-- Back button (for mobile / small screens) -->
            <a href="/Messages" class="flex md:hidden h-8 w-8 items-center justify-center rounded-full text-slate-400 hover:bg-slate-100 hover:text-slate-900 transition-colors shrink-0" dark:hover:bg-white/10 dark:text-slate-100>
                <i class="fa-solid fa-arrow-left text-sm"></i>
            </a>

            <div class="relative shrink-0">
                @if (otherUser != null && !string.IsNullOrEmpty(otherUser.AvatarUrl))
                {
                    <img src="@otherUser.AvatarUrl" alt="@otherName" class="h-10 w-10 rounded-full object-cover shadow-sm" />
                }
                else
                {
                    <div class="flex h-10 w-10 items-center justify-center rounded-full bg-gradient-to-br from-slate-900 to-slate-700 text-white font-bold text-sm shadow-sm">
                        @initial
                    </div>
                }
                <span class="absolute -bottom-0.5 -right-0.5 h-3 w-3 rounded-full border-2 border-white bg-emerald-500"></span>
            </div>

            <div class="min-w-0">
                <h2 class="truncate text-sm font-bold text-slate-900" dark:text-slate-100>@title</h2>
                <p class="flex items-center gap-1.5 text-[11px] font-medium text-emerald-600">
                    <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
                    Đang hoạt động
                </p>
            </div>
        </div>

        @if (otherUserId != 0)
        {
            <div class="flex items-center gap-1.5">
                <button type="button"
                        class="flex h-9 w-9 items-center justify-center rounded-full border border-slate-200 bg-white text-slate-600 hover:bg-slate-50 hover:text-slate-900 transition-all shadow-sm" dark:hover:bg-white/10 dark:text-slate-400 dark:text-slate-100 dark:border-white/10 dark:bg-neutral-900 dark:bg-black
                        title="Gọi thoại"
                        onclick="startVoiceCall(@otherUserId, '@otherName')">
                    <i class="fa-solid fa-phone text-xs"></i>
                </button>
                <button type="button"
                        class="flex h-9 w-9 items-center justify-center rounded-full border border-slate-200 bg-white text-slate-600 hover:bg-slate-50 hover:text-slate-900 transition-all shadow-sm" dark:hover:bg-white/10 dark:text-slate-400 dark:text-slate-100 dark:border-white/10 dark:bg-neutral-900 dark:bg-black
                        title="Gọi video"
                        onclick="startVideoCall(@otherUserId, '@otherName')">
                    <i class="fa-solid fa-video text-xs"></i>
                </button>
            </div>
        }
    </div>

    <!-- CHAT MESSAGES AREA -->
    <div id="chatMessages" class="flex-1 overflow-y-auto p-4 sm:p-6 space-y-3 bg-slate-50/50" dark:bg-neutral-900>
        @if (Model.Messages != null && Model.Messages.Any())
        {
            foreach (var msg in Model.Messages.OrderBy(m => m.CreatedAt))
            {
                var isMine = msg.SenderId == currentUserId;
                var fullName = msg.Sender?.FullName ?? msg.Sender?.Email ?? "Người dùng";
                var msgInitial = !string.IsNullOrEmpty(fullName) ? fullName.Substring(0, 1).ToUpper() : "?";

                <div class="message-item @(isMine ? "sent" : "received")" data-message-id="@msg.Id">
                    @if (isMine)
                    {
                        <div class="flex justify-end">
                            <div class="message-bubble sent-bubble max-w-[75%] sm:max-w-[65%] rounded-2xl rounded-br-sm bg-slate-950 text-white px-4 py-2.5 shadow-sm" dark:bg-white dark:text-black>
                                <p class="message-text text-sm leading-relaxed text-white break-words">@msg.Content</p>
                                <small class="message-time block text-[10px] text-slate-400 mt-1 text-right">
                                    @msg.CreatedAt.ToLocalTime().ToString("HH:mm")
                                </small>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="flex items-start gap-2.5 justify-start">
                            @if (msg.Sender != null && !string.IsNullOrEmpty(msg.Sender.AvatarUrl))
                            {
                                <img src="@msg.Sender.AvatarUrl" alt="@fullName" class="avatar-circle avatar-sm h-8 w-8 rounded-full object-cover shrink-0 mt-0.5" />
                            }
                            else
                            {
                                <div class="avatar-circle avatar-sm flex h-8 w-8 items-center justify-center rounded-full bg-gradient-to-br from-slate-800 to-slate-600 text-white text-xs font-bold shrink-0 mt-0.5">
                                    @msgInitial
                                </div>
                            }
                            <div class="message-bubble received-bubble max-w-[75%] sm:max-w-[65%] rounded-2xl rounded-bl-sm bg-white border border-slate-100 text-slate-900 px-4 py-2.5 shadow-card" dark:text-slate-100 dark:border-white/10 dark:bg-black>
                                <div class="text-[11px] font-bold text-slate-900 mb-0.5" dark:text-slate-100>@fullName</div>
                                <p class="message-text text-sm leading-relaxed text-slate-800 break-words" dark:text-slate-100>@msg.Content</p>
                                <small class="message-time text-muted block text-[10px] text-slate-400 mt-1">
                                    @msg.CreatedAt.ToLocalTime().ToString("HH:mm")
                                </small>
                            </div>
                        </div>
                    }
                </div>
            }
        }
        else
        {
            <div class="flex flex-col items-center justify-center py-16 text-center text-slate-400">
                <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-white border border-slate-100 shadow-sm text-slate-300 mb-3" dark:border-white/10 dark:bg-black>
                    <i class="fa-regular fa-comment-dots text-xl text-slate-700"></i>
                </div>
                <p class="text-sm font-semibold text-slate-700 mb-0.5">Chưa có tin nhắn nào</p>
                <p class="text-xs text-slate-400">Hãy gửi lời chào để bắt đầu cuộc trò chuyện 👋</p>
            </div>
        }
    </div>

    <!-- INPUT BAR -->
    <form id="formSendMessage" class="border-t border-slate-100 bg-white p-3 sm:p-4 shrink-0" dark:border-white/10 dark:bg-black>
        <div class="flex items-center gap-2">
            <textarea name="content"
                      rows="1"
                      placeholder="Nhập tin nhắn..."
                      class="flex-1 resize-none rounded-full border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm font-medium text-slate-800 outline-none focus:border-slate-900 focus:bg-white transition-all placeholder:text-slate-400" dark:text-slate-100 dark:border-white/10 dark:bg-neutral-900 dark:bg-black
                      onkeydown="if(event.key==='Enter' && !event.shiftKey){event.preventDefault();this.form.requestSubmit();}"></textarea>
            
            <button type="submit"
                    class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-slate-950 text-white hover:bg-slate-800 active:scale-95 transition-all shadow-sm" dark:bg-white dark:text-black
                    title="Gửi">
                <i class="fa-solid fa-paper-plane text-xs"></i>
            </button>
        </div>
    </form>
</div>
