@* Views/Shared/_Layout.cshtml - Okem Design *@
@using okem_social.Repositories
@using System.Security.Claims
@inject IUserRepository UserRepository
@{
    okem_social.Models.User? currentUser = null;
    if (User.Identity?.IsAuthenticated == true)
    {
        var idClaim = User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (int.TryParse(idClaim, out int uid))
        {
            currentUser = await UserRepository.GetByIdAsync(uid);
        }
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Okem</title>
    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet">

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"/>

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'Plus Jakarta Sans', 'sans-serif'],
                        heading: ['Plus Jakarta Sans', 'sans-serif']
                    },
                    colors: {
                        brand: {
                            50: '#eef6ff', 100: '#d8ebff', 500: '#0a66c2',
                            600: '#0859aa', 700: '#074b90',
                        },
                        ink: '#0f172a',
                        surface: { light: '#ffffff', dark: '#000000', muted: '#16181c' }
                    },
                    boxShadow: {
                        card: '0 1px 3px rgba(0,0,0,0.05)',
                        lift: '0 10px 40px rgba(0,0,0,0.12)',
                    }
                }
            }
        };
    </script>

    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
</head>
<body class="min-h-screen bg-slate-50 font-sans text-slate-900 antialiased dark:bg-[#0a0a0a] dark:text-slate-100 transition-colors duration-200" dark:bg-neutral-900>

    <!-- ========== NAVBAR ========== -->
    @if (ViewContext.RouteData.Values["controller"]?.ToString() != "Account")
    {
    <header class="sticky top-0 z-50 w-full border-b border-slate-200/60 bg-white/80 backdrop-blur-xl dark:border-white/10 dark:bg-black/80">
        <nav class="mx-auto flex h-16 max-w-[1440px] items-center justify-between gap-4 px-4 sm:px-6">

            <!-- Brand Logo -->
            <a href="@(User.Identity?.IsAuthenticated ?? false ? "/Posts/Feed" : "/")"
               class="flex items-center gap-2.5 font-heading text-[22px] font-bold tracking-tight text-slate-900 hover:opacity-80 transition-opacity shrink-0 dark:text-white">
                <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-slate-950 text-white text-base font-black shadow-sm dark:bg-white dark:text-black" dark:bg-black>L</div>
                <span>Okem</span>
            </a>

            <!-- Mobile Hamburger Button -->
            <div class="flex items-center gap-2 md:hidden">
                <button type="button" onclick="toggleMobileMenu()" aria-label="Menu"
                        class="flex h-10 w-10 items-center justify-center rounded-xl text-slate-500 hover:bg-slate-100 active:scale-95 transition-all dark:text-slate-400 dark:hover:bg-white/10" dark:bg-black>
                    <i class="fa-solid fa-bars text-lg"></i>
                </button>
            </div>

            <!-- Desktop Nav Items -->
            <div class="hidden md:flex items-center gap-4 lg:gap-6">
                @if (User.Identity?.IsAuthenticated ?? false)
                {
                    <!-- Search (desktop) -->
                    <form asp-controller="Users" asp-action="Search" method="get"
                          class="hidden xl:flex h-10 w-[260px] items-center gap-3 rounded-full border border-slate-200 bg-slate-50/80 px-4 focus-within:border-slate-400 focus-within:bg-white transition-all dark:border-white/10 dark:bg-neutral-900">
                        <i class="fa-solid fa-magnifying-glass text-slate-400 text-sm"></i>
                        <input name="keyword" type="search"
                               class="w-full bg-transparent text-sm font-medium text-slate-700 outline-none placeholder:text-slate-400 dark:text-slate-100"
                               placeholder="Tìm kiếm bạn bè, bài viết..."/>
                    </form>

                    <!-- Nav Action Icons -->
                    <div class="flex items-center gap-1">
                        <a asp-controller="Posts" asp-action="Feed" title="Bảng tin"
                           class="flex h-10 w-10 items-center justify-center rounded-full text-slate-500 hover:bg-slate-100 hover:text-slate-900 transition-colors dark:text-slate-400 dark:hover:bg-white/10 dark:hover:text-white" dark:text-slate-100 dark:bg-black>
                            <i class="fa-solid fa-house-chimney text-[17px]"></i>
                        </a>
                        <a asp-controller="Users" asp-action="Search" title="Mạng lưới"
                           class="flex h-10 w-10 items-center justify-center rounded-full text-slate-500 hover:bg-slate-100 hover:text-slate-900 transition-colors dark:text-slate-400 dark:hover:bg-white/10 dark:hover:text-white" dark:text-slate-100 dark:bg-black>
                            <i class="fa-solid fa-user-group text-[17px]"></i>
                        </a>
                        <a asp-controller="Messages" asp-action="Index" title="Tin nhắn"
                           class="flex h-10 w-10 items-center justify-center rounded-full text-slate-500 hover:bg-slate-100 hover:text-slate-900 transition-colors dark:text-slate-400 dark:hover:bg-white/10 dark:hover:text-white" dark:text-slate-100 dark:bg-black>
                            <i class="fa-regular fa-comment-dots text-[17px]"></i>
                        </a>

                        <!-- Notifications Bell -->
                        <div class="relative" id="notifWrap">
                            <button type="button" onclick="toggleNotifDD()" title="Thông báo"
                                    class="relative flex h-10 w-10 items-center justify-center rounded-full text-slate-500 hover:bg-slate-100 hover:text-slate-900 transition-colors dark:text-slate-400 dark:hover:bg-white/10 dark:hover:text-white" dark:text-slate-100 dark:bg-black>
                                <i class="fa-regular fa-bell text-[17px]"></i>
                                <span id="notifBadge" class="hidden absolute right-1 top-1 h-4 min-w-4 items-center justify-center rounded-full bg-blue-600 px-1 text-[10px] font-bold text-white ring-2 ring-white dark:ring-black">0</span>
                            </button>
                            <!-- Notifications Dropdown Popup Modal -->
                            <div id="notifDD" class="hidden absolute right-0 top-full mt-3 w-[380px] rounded-3xl border border-slate-100 bg-white shadow-2xl z-50 overflow-hidden dark:border-white/10 dark:bg-black animate-scaleIn">
                                <div class="flex items-center justify-between border-b border-slate-100 px-6 py-5 dark:border-white/10">
                                    <div>
                                        <h3 class="text-sm font-black tracking-tight text-slate-950 dark:text-white">Thông báo</h3>
                                        <p id="notifSubtitle" class="mt-0.5 text-[11px] font-bold text-slate-400">0 chưa đọc</p>
                                    </div>
                                    <button type="button" onclick="markAllRead()" class="text-[11px] font-black uppercase tracking-widest text-slate-400 hover:text-slate-950 transition-colors dark:hover:text-white" dark:text-slate-100>Đã đọc tất cả</button>
                                </div>
                                <div id="notifList" class="max-h-[360px] overflow-y-auto px-2 py-2 space-y-1">
                                    <p class="py-10 text-center text-xs font-semibold text-slate-400 italic">Không có thông báo mới</p>
                                </div>
                                <a asp-controller="Notifications" asp-action="Index" class="block border-t border-slate-100 py-3.5 text-center text-xs font-black uppercase tracking-widest text-slate-400 hover:bg-slate-50 hover:text-slate-950 transition-colors dark:border-white/10 dark:hover:bg-white/10 dark:hover:text-white" dark:text-slate-100 dark:bg-neutral-900 dark:bg-black>
                                    Xem tất cả thông báo
                                </a>
                            </div>
                        </div>



                        <!-- Settings Link -->
                        <a asp-controller="Settings" asp-action="Index" title="Cài đặt"
                           class="flex h-10 w-10 items-center justify-center rounded-full text-slate-500 hover:bg-slate-100 hover:text-slate-900 transition-colors dark:text-slate-400 dark:hover:bg-white/10 dark:hover:text-white" dark:text-slate-100 dark:bg-black>
                            <i class="fa-solid fa-gear text-[17px]"></i>
                        </a>
                    </div>

                    <!-- User Menu Dropdown -->
                    <div class="relative" id="userWrap">
                        <button type="button" onclick="toggleUserDD()"
                                class="flex items-center gap-2.5 rounded-full p-1 hover:bg-slate-100 transition-all dark:hover:bg-white/10" dark:bg-black>
                            @if (currentUser != null && !string.IsNullOrEmpty(currentUser.AvatarUrl))
                            {
                                <img src="@currentUser.AvatarUrl" alt="@(currentUser.FullName ?? User.Identity?.Name)" class="h-8 w-8 rounded-full object-cover shadow-sm ring-2 ring-white/50" />
                            }
                            else
                            {
                                <div class="flex h-8 w-8 items-center justify-center rounded-full bg-gradient-to-br from-slate-900 to-slate-700 text-xs font-bold text-white uppercase shadow-sm">
                                    @(currentUser?.FullName != null ? currentUser.FullName.Substring(0, 1).ToUpper() : (User.Identity?.Name != null ? User.Identity.Name.Substring(0, 1).ToUpper() : "U"))
                                </div>
                            }
                            <span class="hidden xl:block max-w-[120px] truncate text-sm font-bold tracking-tight text-slate-800 dark:text-slate-200" dark:text-slate-100>@(currentUser?.FullName ?? User.Identity?.Name)</span>
                            <i class="fa-solid fa-chevron-down text-[10px] text-slate-400 hidden xl:block"></i>
                        </button>
                        <div id="userDD" class="hidden absolute right-0 top-full mt-3 w-56 rounded-2xl border border-slate-100 bg-white p-2 shadow-2xl z-50 dark:border-white/10 dark:bg-black animate-scaleIn">
                            <a asp-controller="Profile" asp-action="Me" class="flex items-center gap-3 rounded-xl px-4 py-2.5 text-sm font-bold text-slate-700 hover:bg-slate-50 hover:text-slate-950 transition-colors dark:text-slate-200 dark:hover:bg-white/10" dark:text-slate-100 dark:bg-neutral-900 dark:bg-black>
                                <i class="fa-regular fa-user w-4 text-center text-slate-400"></i> Hồ sơ cá nhân
                            </a>
                            <a asp-controller="Settings" asp-action="Index" class="flex items-center gap-3 rounded-xl px-4 py-2.5 text-sm font-bold text-slate-700 hover:bg-slate-50 hover:text-slate-950 transition-colors dark:text-slate-200 dark:hover:bg-white/10" dark:text-slate-100 dark:bg-neutral-900 dark:bg-black>
                                <i class="fa-solid fa-gear w-4 text-center text-slate-400"></i> Cài đặt
                            </a>
                            <div class="my-1 h-px bg-slate-100 dark:bg-white/10" dark:bg-black></div>
                            <form asp-controller="Account" asp-action="Logout" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="flex w-full items-center gap-3 rounded-xl px-4 py-2.5 text-sm font-bold text-red-600 hover:bg-red-50 transition-colors text-left dark:hover:bg-red-950/20">
                                    <i class="fa-solid fa-arrow-right-from-bracket w-4 text-center text-red-500"></i> Đăng xuất
                                </button>
                            </form>
                        </div>
                    </div>
                }
                else
                {
                    <div class="flex items-center gap-4">
                        <a asp-controller="Account" asp-action="Login" class="text-sm font-bold text-slate-600 hover:text-slate-900 transition-colors dark:text-slate-300 dark:hover:text-white" dark:text-slate-400 dark:text-slate-100>
                            Đăng nhập
                        </a>
                        <a asp-controller="Account" asp-action="Register" class="inline-flex items-center justify-center rounded-full bg-slate-950 px-7 py-2.5 text-sm font-bold text-white shadow-sm hover:bg-slate-800 active:scale-95 transition-all dark:bg-white dark:text-black dark:hover:bg-slate-200" dark:bg-black>
                            Đăng ký
                        </a>
                    </div>
                }
            </div>
        </nav>

        <!-- Mobile Drawer Menu -->
        <div id="mobileMenu" class="hidden border-b border-slate-200/60 bg-white px-6 py-5 shadow-lg md:hidden dark:border-white/10 dark:bg-black">
            @if (User.Identity?.IsAuthenticated ?? false)
            {
                <form asp-controller="Users" asp-action="Search" method="get" class="mb-4 flex h-10 w-full items-center gap-3 rounded-full border border-slate-200 bg-slate-50 px-4 dark:border-white/10 dark:bg-neutral-900">
                    <i class="fa-solid fa-magnifying-glass text-slate-400 text-sm"></i>
                    <input name="keyword" type="search" class="w-full bg-transparent text-sm font-medium text-slate-700 outline-none placeholder:text-slate-400 dark:text-slate-100" placeholder="Tìm kiếm..." />
                </form>
                <div class="space-y-1">
                    <a asp-controller="Posts" asp-action="Feed" class="flex items-center gap-3 rounded-xl px-4 py-2.5 text-sm font-bold text-slate-700 hover:bg-slate-50 dark:text-slate-200 dark:hover:bg-white/10" dark:bg-neutral-900 dark:bg-black>
                        <i class="fa-solid fa-house-chimney w-5 text-center text-slate-400"></i> Bảng tin
                    </a>
                    <a asp-controller="Users" asp-action="Search" class="flex items-center gap-3 rounded-xl px-4 py-2.5 text-sm font-bold text-slate-700 hover:bg-slate-50 dark:text-slate-200 dark:hover:bg-white/10" dark:bg-neutral-900 dark:bg-black>
                        <i class="fa-solid fa-user-group w-5 text-center text-slate-400"></i> Mạng lưới
                    </a>
                    <a asp-controller="Messages" asp-action="Index" class="flex items-center gap-3 rounded-xl px-4 py-2.5 text-sm font-bold text-slate-700 hover:bg-slate-50 dark:text-slate-200 dark:hover:bg-white/10" dark:bg-neutral-900 dark:bg-black>
                        <i class="fa-regular fa-comment-dots w-5 text-center text-slate-400"></i> Tin nhắn
                    </a>
                    <a asp-controller="Notifications" asp-action="Index" class="flex items-center gap-3 rounded-xl px-4 py-2.5 text-sm font-bold text-slate-700 hover:bg-slate-50 dark:text-slate-200 dark:hover:bg-white/10" dark:bg-neutral-900 dark:bg-black>
                        <i class="fa-regular fa-bell w-5 text-center text-slate-400"></i> Thông báo
                    </a>
                    <a asp-controller="Profile" asp-action="Me" class="flex items-center gap-3 rounded-xl px-4 py-2.5 text-sm font-bold text-slate-700 hover:bg-slate-50 dark:text-slate-200 dark:hover:bg-white/10" dark:bg-neutral-900 dark:bg-black>
                        <i class="fa-regular fa-user w-5 text-center text-slate-400"></i> Hồ sơ cá nhân (@User.Identity?.Name)
                    </a>
                    <a asp-controller="Settings" asp-action="Index" class="flex items-center gap-3 rounded-xl px-4 py-2.5 text-sm font-bold text-slate-700 hover:bg-slate-50 dark:text-slate-200 dark:hover:bg-white/10" dark:bg-neutral-900 dark:bg-black>
                        <i class="fa-solid fa-gear w-5 text-center text-slate-400"></i> Cài đặt
                    </a>
                    <div class="my-2 h-px bg-slate-100 dark:bg-white/10" dark:bg-black></div>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="flex w-full items-center gap-3 rounded-xl px-4 py-2.5 text-sm font-bold text-red-600 hover:bg-red-50 text-left dark:hover:bg-red-950/20">
                            <i class="fa-solid fa-arrow-right-from-bracket w-5 text-center text-red-500"></i> Đăng xuất
                        </button>
                    </form>
                </div>
            }
            else
            {
                <div class="flex flex-col gap-3">
                    <a asp-controller="Account" asp-action="Login" class="w-full text-center rounded-xl border border-slate-200 py-2.5 text-sm font-bold text-slate-700 hover:bg-slate-50 dark:border-white/10 dark:text-slate-200" dark:hover:bg-white/10 dark:bg-neutral-900>
                        Đăng nhập
                    </a>
                    <a asp-controller="Account" asp-action="Register" class="w-full text-center rounded-xl bg-slate-950 py-2.5 text-sm font-bold text-white hover:bg-slate-800 dark:bg-white dark:text-black" dark:bg-black>
                        Đăng ký
                    </a>
                </div>
            }
        </div>
    </header>
    }

    <!-- ========== MAIN ========== -->
    <main class="mx-auto max-w-[1440px] px-4 py-6 sm:px-6 min-h-[calc(100vh-130px)]">
        @RenderBody()
    </main>

    <!-- ========== FLOATING CHAT POPUP ========== -->
    <div id="chatPopup" class="hidden"></div>

    <!-- ========== CALL OVERLAY (WINDOWED) ========== -->
    <div id="callOverlay" class="hidden fixed top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[90%] max-w-4xl h-[80vh] min-h-[500px] max-h-[800px] z-[60] bg-slate-950 rounded-3xl overflow-hidden shadow-[0_0_50px_rgba(0,0,0,0.5)] flex flex-col text-white border border-white/10 transition-all duration-300" dark:bg-white dark:text-black>
        <div class="flex items-center justify-between px-6 py-3 border-b border-white/10 bg-slate-900/80 backdrop-blur-md cursor-move" id="callHeader">
            <div class="flex items-center gap-3">
                <div class="flex h-10 w-10 items-center justify-center rounded-full bg-gradient-to-br from-blue-500 to-indigo-600 font-bold shadow-sm" id="callAvatarSmall">
                    <i class="fa-solid fa-user text-sm"></i>
                </div>
                <div>
                    <strong id="callPeerName" class="text-sm font-bold">Đang gọi...</strong><br>
                    <span id="callStatus" class="text-[11px] text-emerald-400 font-medium">Cuộc gọi</span>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <button onclick="minimizeCall()" class="flex h-8 w-8 items-center justify-center rounded-full hover:bg-white/10 transition-colors" dark:bg-black title="Thu nhỏ"><i class="fa-solid fa-minus text-xs"></i></button>
                <button onclick="endCall()" class="flex h-8 w-8 items-center justify-center rounded-full hover:bg-red-500/20 text-red-500 transition-colors" title="Đóng"><i class="fa-solid fa-xmark text-sm"></i></button>
            </div>
        </div>
        <div class="relative flex-1 bg-black flex items-center justify-center overflow-hidden">
            <video id="remoteVideo" class="w-full h-full object-cover" autoplay playsinline></video>
            <video id="localVideo" class="absolute bottom-4 right-4 w-32 h-44 rounded-2xl object-cover border-2 border-white/20 shadow-2xl bg-slate-900 z-[20]" autoplay muted playsinline></video>
            <audio id="remoteAudio" autoplay class="hidden"></audio>
            <div id="callLoading" class="absolute inset-0 z-10 bg-slate-950/90 flex flex-col items-center justify-center gap-4">
                <div class="h-24 w-24 rounded-full bg-gradient-to-br from-blue-500 to-indigo-600 flex items-center justify-center text-4xl font-bold shadow-2xl" id="callAvatar">?</div>
                <h3 id="callHeading" class="text-2xl font-bold">Người dùng</h3>
                <p id="callLoadingText" class="text-sm text-slate-400 flex items-center gap-2"><i class="fa-solid fa-circle-notch fa-spin text-blue-400"></i> Đang kết nối...</p>
            </div>
        </div>
        <div class="flex items-center justify-center gap-5 py-4 bg-slate-900/95 backdrop-blur-md border-t border-white/10 shrink-0">
            <button id="btnMic" onclick="toggleMic()" class="w-12 h-12 rounded-full bg-white/10 hover:bg-white/20 flex items-center justify-center transition-all shadow-sm" dark:bg-black><i class="fa-solid fa-microphone text-sm"></i></button>
            <button id="btnCam" onclick="toggleCam()" class="w-12 h-12 rounded-full bg-white/10 hover:bg-white/20 flex items-center justify-center transition-all shadow-sm" dark:bg-black><i class="fa-solid fa-video text-sm"></i></button>
            <button onclick="endCall()" class="w-14 h-14 rounded-full bg-red-600 hover:bg-red-700 flex items-center justify-center transition-all hover:scale-105 active:scale-95 shadow-lg"><i class="fa-solid fa-phone-slash text-lg"></i></button>
        </div>
    </div>

    <!-- ========== FOOTER ========== -->
    <footer class="border-t border-slate-200/60 bg-white py-5 text-sm text-slate-500 dark:border-white/10 dark:bg-black dark:text-slate-400 transition-colors duration-200">
        <div class="mx-auto max-w-[1440px] px-4 sm:px-6 flex flex-col sm:flex-row items-center justify-between gap-3">
            <div class="flex items-center gap-2">
                <span class="font-bold text-slate-900" dark:text-slate-100>Okem</span>
                <span class="text-slate-400">© @DateTime.Now.Year</span>
            </div>
            <div class="flex gap-5 text-xs font-semibold">
                <a asp-controller="Home" asp-action="Privacy" class="hover:text-slate-900 transition-colors">Bảo mật</a>
                <a asp-controller="Home" asp-action="Terms" class="hover:text-slate-900 transition-colors">Điều khoản</a>
                <a href="#" class="hover:text-slate-900 transition-colors" dark:text-slate-100>Trợ giúp</a>
            </div>
        </div>
    </footer>

    <!-- ========== SCRIPTS ========== -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/call.js" asp-append-version="true"></script>
    <script>
        // -- Mobile menu --
        function toggleMobileMenu() {
            document.getElementById('mobileMenu')?.classList.toggle('hidden');
        }

        // Force disable dark mode for all users
        (function() {
            document.documentElement.classList.remove('dark');
            localStorage.removeItem('theme');
        })();

        // -- Dropdown helpers --
        function toggleNotifDD() { document.getElementById('notifDD')?.classList.toggle('hidden'); }
        function toggleUserDD() { document.getElementById('userDD')?.classList.toggle('hidden'); }
        document.addEventListener('click', e => {
            if (!document.getElementById('notifWrap')?.contains(e.target)) document.getElementById('notifDD')?.classList.add('hidden');
            if (!document.getElementById('userWrap')?.contains(e.target)) document.getElementById('userDD')?.classList.add('hidden');
        });

        // -- Notification loader (graceful) --
        async function loadNotifs() {
            try {
                const r = await fetch('/api/notifications', {headers:{'X-Requested-With':'XMLHttpRequest'}});
                if (!r.ok) return;
                const items = await r.json();
                const list = document.getElementById('notifList');
                const badge = document.getElementById('notifBadge');
                if (!items?.length) { list.innerHTML='<p class="py-10 text-center text-xs font-semibold text-slate-400">Không có thông báo mới</p>'; badge?.classList.add('hidden'); return; }
                const unread = items.filter(x=>!x.read && !x.isRead).length;
                if (badge) { if(unread>0){badge.textContent=unread>9?'9+':unread;badge.classList.remove('hidden');badge.classList.add('flex');}else{badge.classList.add('hidden');} }
                list.innerHTML = items.slice(0,8).map(n=>`
                    <a href="${n.url||'/Notifications'}" class="flex gap-3 px-4 py-3 hover:bg-slate-50 transition-colors ${n.read||n.isRead?'':'bg-blue-50/40'}" dark:hover:bg-white/10 dark:bg-neutral-900>
                        <div class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-full ${n.read||n.isRead?'bg-slate-100 text-slate-400':'bg-blue-100 text-blue-600'}"><i class="fa-regular fa-bell text-xs"></i></div>
                        <div class="min-w-0 flex-1"><p class="truncate text-xs font-semibold text-slate-800" dark:text-slate-100>${n.title||'Thông báo'}</p><p class="mt-0.5 text-xs text-slate-500 line-clamp-2" dark:text-slate-400>${n.content||''}</p></div>
                    </a>`).join('');
            } catch(e){}
        }
        async function markAllRead() { try { await fetch('/api/notifications/read-all',{method:'POST',headers:{'X-Requested-With':'XMLHttpRequest'}}); loadNotifs(); } catch(e){} }

        // -- Helper to open chat popup with user ID --
        async function openChatPopupWithUser(targetUserId, targetName, targetAvatar = null) {
            try {
                const res = await fetch(`/api/conversations/direct/${targetUserId}`, {
                    method: 'POST',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });
                if (!res.ok) throw new Error('Không thể mở cuộc trò chuyện');
                const conv = await res.json();
                
                let avatarUrl = targetAvatar;
                if (!avatarUrl && conv.members) {
                    const other = conv.members.find(m => m.id === targetUserId);
                    if (other && other.avatarUrl) avatarUrl = other.avatarUrl;
                }
                
                openChatPopup(conv.id, conv.name || targetName, targetUserId, avatarUrl);
            } catch (e) {
                console.error(e);
                alert("Lỗi khi mở chat.");
            }
        }

        // -- Chat Popup (Okem / Instagram style) --
        function openChatPopup(convId, name, peerId, avatarUrl = null) {
            const el = document.getElementById('chatPopup');
            if (!el) return;
            el.className = 'chat-popup';
            
            const avatarHtml = avatarUrl 
                ? `<img src="${avatarUrl}" alt="${name}" class="h-9 w-9 rounded-full object-cover shadow-sm" />`
                : `<div class="flex h-9 w-9 items-center justify-center rounded-full bg-gradient-to-br from-slate-900 to-slate-600 text-xs font-bold text-white">${name?name[0].toUpperCase():'U'}</div>`;
                
            el.innerHTML = `
                <div class="flex items-center justify-between border-b border-slate-200 px-4 py-3 bg-white" dark:border-white/10 dark:bg-black>
                    <div class="flex items-center gap-3 min-w-0">
                        <div class="relative shrink-0">
                            ${avatarHtml}
                            <span class="absolute -bottom-0.5 -right-0.5 h-3 w-3 rounded-full border-2 border-white bg-emerald-500"></span>
                        </div>
                        <div class="min-w-0"><h2 class="truncate text-sm font-bold text-slate-900" dark:text-slate-100>${name||'Chat'}</h2><p class="text-[10px] font-bold uppercase tracking-widest text-emerald-600">Trực tuyến</p></div>
                    </div>
                    <div class="flex items-center gap-0.5">
                        <button onclick="startVoiceCall(${peerId||0},'${name}')" class="p-2 rounded-full text-slate-500 hover:bg-slate-100 transition-colors" dark:hover:bg-white/10 dark:text-slate-400 title="Gọi thoại"><i class="fa-solid fa-phone text-xs"></i></button>
                        <button onclick="startVideoCall(${peerId||0},'${name}')" class="p-2 rounded-full text-slate-500 hover:bg-slate-100 transition-colors" dark:hover:bg-white/10 dark:text-slate-400 title="Gọi video"><i class="fa-solid fa-video text-xs"></i></button>
                        <button onclick="closeChatPopup()" class="p-2 rounded-full text-slate-500 hover:bg-slate-100 transition-colors" dark:hover:bg-white/10 dark:text-slate-400><i class="fa-solid fa-xmark text-sm"></i></button>
                    </div>
                </div>
                <div id="popupMsgs" class="flex-1 overflow-y-auto bg-slate-50 px-4 py-3 space-y-2" dark:bg-neutral-900><p class="text-center text-xs text-slate-400 py-8 italic">Đang tải...</p></div>
                <div class="border-t border-slate-200 bg-white p-3" dark:border-white/10 dark:bg-black>
                    <div class="flex items-center gap-2">
                        <input id="popupInput" class="flex-1 rounded-full border border-slate-200 bg-slate-50 px-4 py-2 text-sm outline-none focus:border-slate-900 focus:bg-white transition-all" dark:border-white/10 dark:bg-neutral-900 dark:bg-black placeholder="Nhập tin nhắn..." onkeydown="if(event.key==='Enter')sendPopup(${convId})" />
                        <button onclick="sendPopup(${convId})" class="flex h-9 w-9 items-center justify-center rounded-full bg-slate-950 text-white hover:bg-slate-800 active:scale-95 transition-all shadow-sm" dark:bg-white dark:text-black><i class="fa-solid fa-paper-plane text-xs"></i></button>
                    </div>
                </div>`;
            loadPopupMsgs(convId);
        }
        function closeChatPopup() { const el=document.getElementById('chatPopup'); if(el) el.className='hidden'; }
        async function loadPopupMsgs(id) {
            try {
                const r=await fetch(`/api/conversations/${id}/messages`,{headers:{'X-Requested-With':'XMLHttpRequest'}});
                if(!r.ok)return;const msgs=await r.json();const c=document.getElementById('popupMsgs');if(!c)return;
                if(!msgs?.length){c.innerHTML='<p class="text-center text-xs text-slate-400 py-8 italic">Chưa có tin nhắn</p>';return;}
                const me='@User.Identity?.Name';
                c.innerHTML=msgs.map(m=>{const mine=m.sender?.email===me||m.sender?.fullName===me||m.isMine;return`<div class="flex ${mine?'justify-end':'justify-start'}"><div class="max-w-[80%] rounded-2xl px-3.5 py-2 text-sm shadow-sm ${mine?'rounded-br-sm bg-slate-950 text-white':'rounded-bl-sm bg-white text-slate-900 border border-slate-100'}" dark:bg-white dark:text-black dark:text-slate-100 dark:border-white/10 dark:bg-black>${m.content?`<p class="whitespace-pre-wrap">${m.content}</p>`:''}${m.attachmentUrl?`<img src="${m.attachmentUrl}" class="max-h-36 rounded-lg mt-1"/>`:''}</div></div>`;}).join('');
                c.scrollTop=c.scrollHeight;
            } catch(e){}
        }
        async function sendPopup(id) {
            const inp=document.getElementById('popupInput');const t=inp?.value.trim();if(!t)return;inp.value='';
            try{await fetch(`/api/conversations/${id}/messages`,{method:'POST',headers:{'Content-Type':'application/json','X-Requested-With':'XMLHttpRequest'},body:JSON.stringify({content:t})});loadPopupMsgs(id);}catch(e){}
        }

        // Load notifications on page ready
        if (document.getElementById('notifBadge')) setTimeout(loadNotifs, 500);
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
