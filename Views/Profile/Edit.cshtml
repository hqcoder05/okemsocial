@model okem_social.Models.User
@{
    ViewData["Title"] = "Chỉnh sửa hồ sơ";
    string avatar = ViewBag.AvatarUrl as string ?? (string.IsNullOrEmpty(Model.AvatarUrl) ? "/img/avatar-default.png" : Model.AvatarUrl);
    string handle = ViewBag.Handle as string ?? ("@" + (Model.Nickname ?? Model.Email?.Split('@')[0] ?? "user"));
}

<div class="max-w-3xl mx-auto py-8 px-4">
    <div class="rounded-3xl border border-slate-100 bg-white shadow-card overflow-hidden" dark:border-white/10 dark:bg-black>
        
        <!-- Header -->
        <div class="flex items-center justify-between p-6 sm:px-8 border-b border-slate-100" dark:border-white/10>
            <div class="flex items-center gap-4">
                <a asp-controller="Profile" asp-action="Me" class="w-10 h-10 rounded-full flex items-center justify-center text-slate-500 hover:bg-slate-50 hover:text-slate-900 transition-colors" dark:hover:bg-white/10 dark:text-slate-400 dark:text-slate-100 dark:bg-neutral-900>
                    <i class="fa-solid fa-arrow-left"></i>
                </a>
                <h2 class="text-xl font-heading font-bold text-slate-900" dark:text-slate-100>Chỉnh sửa hồ sơ</h2>
            </div>
            <span class="text-xs font-bold bg-slate-100 text-slate-600 px-3 py-1 rounded-full" dark:text-slate-400>ID #@Model.Id</span>
        </div>

        <div class="p-6 sm:p-8">
            @if (TempData["ok"] != null)
            {
                <div class="mb-6 p-4 rounded-2xl bg-green-50 border border-green-100 text-green-700 text-sm font-medium flex items-center gap-2">
                    <i class="fa-solid fa-check-circle"></i> @TempData["ok"]
                </div>
            }
            @if (TempData["err"] != null)
            {
                <div class="mb-6 p-4 rounded-2xl bg-red-50 border border-red-100 text-red-700 text-sm font-medium flex items-center gap-2">
                    <i class="fa-solid fa-triangle-exclamation"></i> @TempData["err"]
                </div>
            }

            <form asp-action="Edit" method="post" enctype="multipart/form-data" id="editForm" novalidate class="flex flex-col md:flex-row gap-8">
                @Html.AntiForgeryToken()

                <!-- Avatar Section (Left) -->
                <div class="w-full md:w-1/3 flex flex-col items-center">
                    <div class="relative group cursor-pointer w-32 h-32 rounded-full overflow-hidden border-4 border-white shadow-card mb-4 bg-slate-50" dark:bg-neutral-900>
                        <img id="avatarPreview" src="@avatar" alt="Avatar" class="w-full h-full object-cover" />
                        <label class="absolute inset-0 bg-slate-900/40 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity cursor-pointer text-white">
                            <i class="fa-solid fa-camera text-2xl"></i>
                            <input type="file" id="avatarInput" name="avatar" accept="image/*" class="hidden">
                        </label>
                    </div>
                    
                    <div class="text-center mb-4">
                        <div class="text-sm font-bold text-slate-900 mb-1" dark:text-slate-100>@handle</div>
                        <div class="text-xs font-medium text-slate-500" dark:text-slate-400>JPG/PNG/WEBP ≤ 5MB</div>
                    </div>

                    <label class="inline-flex items-center justify-center rounded-full border border-slate-200 bg-white text-slate-700 px-5 py-2 text-sm font-bold hover:bg-slate-50 transition-colors w-full cursor-pointer mb-2" dark:hover:bg-white/10 dark:border-white/10 dark:bg-neutral-900 dark:bg-black>
                        Thay ảnh mới
                        <input type="file" id="avatarInputBtn" name="avatarBtn" accept="image/*" class="hidden" onchange="document.getElementById('avatarInput').files = this.files; document.getElementById('avatarInput').dispatchEvent(new Event('change'))">
                    </label>

                    @if (!string.IsNullOrEmpty(Model.AvatarUrl))
                    {
                        <button type="button" onclick="document.getElementById('deleteAvatarForm').submit();" class="inline-flex items-center justify-center rounded-full border border-red-100 bg-red-50 text-red-600 px-5 py-2 text-sm font-bold hover:bg-red-100 transition-colors w-full">
                            Xoá ảnh hiện tại
                        </button>
                    }
                </div>

                <!-- Form Fields (Right) -->
                <div class="w-full md:w-2/3 space-y-5">
                    
                    <div>
                        <label for="fullName" class="block text-sm font-bold text-slate-900 mb-2" dark:text-slate-100>Họ và tên <span class="text-red-500">*</span></label>
                        <input type="text" id="fullName" name="fullName" value="@Model.FullName" required minlength="2" maxlength="120" placeholder="Nhập họ và tên của bạn..." class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm outline-none focus:border-slate-900 focus:bg-white transition-colors" dark:border-white/10 dark:bg-neutral-900 dark:bg-black />
                    </div>

                    <div>
                        <label for="nickname" class="block text-sm font-bold text-slate-900 mb-2" dark:text-slate-100>Nickname</label>
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 flex items-center pl-4 pointer-events-none text-slate-400 font-bold">
                                @@
                            </div>
                            <input type="text" id="nickname" name="nickname" value="@Model.Nickname" minlength="3" maxlength="30" placeholder="vd: quoc_coder" class="w-full rounded-xl border border-slate-200 bg-slate-50 pl-9 pr-4 py-3 text-sm outline-none focus:border-slate-900 focus:bg-white transition-colors" dark:border-white/10 dark:bg-neutral-900 dark:bg-black />
                        </div>
                        <p class="mt-2 text-xs font-medium text-slate-500" dark:text-slate-400>3–30 ký tự, hiển thị trên trang cá nhân.</p>
                    </div>

                    <div>
                        <label for="headline" class="block text-sm font-bold text-slate-900 mb-2" dark:text-slate-100>Chức danh / Tiêu đề nghề nghiệp</label>
                        <input type="text" id="headline" name="headline" value="@Model.Headline" maxlength="120" placeholder="vd: Lead Fullstack .NET & React Engineer" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm outline-none focus:border-slate-900 focus:bg-white transition-colors" dark:border-white/10 dark:bg-neutral-900 dark:bg-black />
                    </div>

                    <div>
                        <label for="location" class="block text-sm font-bold text-slate-900 mb-2" dark:text-slate-100>Địa điểm</label>
                        <input type="text" id="location" name="location" value="@Model.Location" maxlength="200" placeholder="vd: Hồ Chí Minh, Việt Nam" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm outline-none focus:border-slate-900 focus:bg-white transition-colors" dark:border-white/10 dark:bg-neutral-900 dark:bg-black />
                    </div>

                    <div>
                        <label for="websiteUrl" class="block text-sm font-bold text-slate-900 mb-2" dark:text-slate-100>Website / Portfolio</label>
                        <input type="url" id="websiteUrl" name="websiteUrl" value="@Model.WebsiteUrl" maxlength="500" placeholder="https://github.com/..." class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm outline-none focus:border-slate-900 focus:bg-white transition-colors" dark:border-white/10 dark:bg-neutral-900 dark:bg-black />
                    </div>

                    <div>
                        <label for="coverUrl" class="block text-sm font-bold text-slate-900 mb-2" dark:text-slate-100>Ảnh bìa (URL hoặc tải lên)</label>
                        <input type="text" id="coverUrl" name="coverUrl" value="@Model.CoverUrl" maxlength="500" placeholder="https://images.unsplash.com/..." class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm outline-none focus:border-slate-900 focus:bg-white transition-colors mb-2" dark:border-white/10 dark:bg-neutral-900 dark:bg-black />
                        <input type="file" name="cover" accept="image/*" class="w-full text-xs text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-xs file:font-semibold file:bg-slate-100 file:text-slate-700 hover:file:bg-slate-200 cursor-pointer" dark:text-slate-400 />
                    </div>

                    <div>
                        <label for="bio" class="block text-sm font-bold text-slate-900 mb-2" dark:text-slate-100>Tiểu sử</label>
                        <textarea id="bio" name="bio" rows="4" maxlength="300" placeholder="Chia sẻ vài điều thú vị về bạn..." class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm outline-none focus:border-slate-900 focus:bg-white transition-colors resize-none" dark:border-white/10 dark:bg-neutral-900 dark:bg-black>@Model.Bio</textarea>
                    </div>

                    <div class="pt-6 flex justify-end gap-3 border-t border-slate-100" dark:border-white/10>
                        <a asp-controller="Profile" asp-action="Me" class="inline-flex items-center justify-center rounded-full border border-slate-200 bg-white text-slate-700 px-6 py-2.5 text-sm font-bold hover:bg-slate-50 transition-colors" dark:hover:bg-white/10 dark:border-white/10 dark:bg-neutral-900 dark:bg-black>
                            Hủy
                        </a>
                        <button type="submit" class="inline-flex items-center justify-center rounded-full bg-slate-950 text-white px-8 py-2.5 text-sm font-bold hover:bg-slate-800 transition-colors" dark:bg-white dark:text-black>
                            Lưu thay đổi
                        </button>
                    </div>
                </div>
            </form>

            <form id="deleteAvatarForm" asp-action="DeleteAvatar" method="post" class="hidden">
                @Html.AntiForgeryToken()
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
    (function(){
      const form = document.getElementById('editForm');
      const fullName = document.getElementById('fullName');
      const nickname = document.getElementById('nickname');
      const file = document.getElementById('avatarInput');
      const img = document.getElementById('avatarPreview');

      form?.addEventListener('submit', function(){
        if (fullName) fullName.value = fullName.value.trim();
        if (nickname) nickname.value = nickname.value.trim().toLowerCase();
      });

      file?.addEventListener('change', function(){
        const f = file.files?.[0]; if (!f) return;
        if (!/^image\//.test(f.type)) { alert('Vui lòng chọn một tập tin hình ảnh hợp lệ.'); file.value=''; return; }
        if (f.size > 5 * 1024 * 1024) { alert('Kích thước ảnh tối đa là 5MB.'); file.value=''; return; }
        img.src = URL.createObjectURL(f);
      });
    })();
    </script>
}
