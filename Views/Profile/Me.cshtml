@model okem_social.Models.User
@{
    ViewData["Title"] = "Hồ sơ";
    var userId = Model.Id;
    var displayName = string.IsNullOrWhiteSpace(Model.FullName) ? Model.Email : Model.FullName;
    var avatarText = !string.IsNullOrWhiteSpace(displayName) ? displayName.Trim()[0].ToString().ToUpper() : "U";
}

<div class="max-w-5xl mx-auto space-y-6 lg:space-y-8">
    <!-- COVER BANNER -->
    <div class="relative h-48 sm:h-64 rounded-b-3xl bg-gradient-to-r from-slate-900 to-slate-700 overflow-hidden shadow-sm">
        @if (!string.IsNullOrEmpty(Model.CoverUrl))
        {
            <img src="@Model.CoverUrl" alt="Cover" class="w-full h-full object-cover opacity-85" />
        }
    </div>

    <!-- PROFILE HEADER -->
    <div class="px-4 sm:px-8 pb-6">
        <div class="flex flex-col sm:flex-row items-center sm:items-end gap-4 sm:gap-6 -mt-20 sm:-mt-24 relative z-10 text-center sm:text-left">
            <!-- Avatar -->
            <div class="relative flex-shrink-0">
                <div class="w-32 h-32 sm:w-40 sm:h-40 rounded-full bg-gradient-to-br from-slate-900 to-slate-700 text-white font-bold flex items-center justify-center text-5xl sm:text-6xl border-4 border-slate-50 shadow-card overflow-hidden">
                    @if (!string.IsNullOrEmpty(Model.AvatarUrl))
                    {
                        <img src="@Model.AvatarUrl" alt="Avatar" class="w-full h-full rounded-full object-cover" onerror="this.onerror=null; this.src='https://ui-avatars.com/api/?name=@Uri.EscapeDataString(displayName)&background=1e293b&color=fff';" />
                    }
                    else
                    {
                        <span>@avatarText</span>
                    }
                </div>
            </div>

            <!-- Info & Actions -->
            <div class="flex-grow flex flex-col sm:flex-row sm:items-end justify-between gap-4 w-full">
                <div class="pt-2 sm:pt-0">
                    <h1 class="text-2xl sm:text-3xl font-heading font-bold text-slate-950" dark:text-slate-100>@displayName</h1>
                    @if (!string.IsNullOrEmpty(Model.Headline))
                    {
                        <p class="text-sm font-semibold text-blue-600 mt-0.5">@Model.Headline</p>
                    }
                    <div class="text-slate-600 mt-1 flex flex-col sm:flex-row sm:items-center justify-center sm:justify-start gap-1 sm:gap-3" dark:text-slate-400>
                        <span class="text-sm font-medium">@Model.Email</span>
                        <span class="hidden sm:inline text-slate-300">•</span>
                        <span class="text-sm">Tham gia tháng @Model.CreatedAt.ToLocalTime().ToString("MM/yyyy")</span>
                    </div>
                </div>
                
                <div class="flex-shrink-0 flex justify-center sm:justify-end">
                    <a asp-controller="Profile" asp-action="Edit" class="inline-flex items-center justify-center rounded-full border border-slate-200 bg-white text-slate-700 px-6 py-2.5 text-sm font-bold hover:bg-slate-50 transition-colors shadow-sm" dark:hover:bg-white/10 dark:border-white/10 dark:bg-neutral-900 dark:bg-black>
                        <i class="fa-regular fa-pen-to-square me-2"></i> Chỉnh sửa hồ sơ
                    </a>
                </div>
            </div>
        </div>

        <!-- Stats Row -->
        <div class="flex items-center justify-center sm:justify-start gap-8 sm:gap-12 mt-8 py-5 border-y border-slate-100" dark:border-white/10>
            <div class="flex flex-col items-center sm:items-start">
                <span class="text-xl font-bold text-slate-950" dark:text-slate-100 id="stat-posts">0</span>
                <span class="text-sm font-medium text-slate-500" dark:text-slate-400>Bài viết</span>
            </div>
            <div class="flex flex-col items-center sm:items-start">
                <span class="text-xl font-bold text-slate-950" dark:text-slate-100 id="stat-friends">0</span>
                <span class="text-sm font-medium text-slate-500" dark:text-slate-400>Bạn bè</span>
            </div>
            <div class="flex flex-col items-center sm:items-start">
                <span class="text-xl font-bold text-slate-950" dark:text-slate-100 id="stat-requests">0</span>
                <span class="text-sm font-medium text-slate-500" dark:text-slate-400>Lời mời</span>
            </div>
        </div>
    </div>

    <!-- MAIN TWO-COLUMN LAYOUT -->
    <div class="flex flex-col lg:flex-row gap-6 lg:gap-8 px-4 sm:px-8 pb-12">
        <!-- Left: Feed -->
        <div class="w-full lg:w-2/3 space-y-6">
            <h2 class="text-xl font-heading font-bold text-slate-900 px-1" dark:text-slate-100>Bài viết của bạn</h2>
            <div id="profile-posts-list" class="space-y-6">
                <!-- Posts via JS -->
            </div>
            
            <div id="profile-posts-empty" class="hidden rounded-3xl border border-slate-100 bg-white shadow-card p-12 text-center" dark:border-white/10 dark:bg-black>
                <div class="w-20 h-20 bg-slate-50 rounded-full flex items-center justify-center mx-auto mb-5" dark:bg-neutral-900>
                    <i class="fa-regular fa-images text-3xl text-slate-400"></i>
                </div>
                <h3 class="text-lg font-bold text-slate-900 mb-2" dark:text-slate-100>Chưa có bài viết</h3>
                <p class="text-slate-500 mb-6 text-sm" dark:text-slate-400>Bắt đầu chia sẻ khoảnh khắc đầu tiên của bạn.</p>
                <a asp-controller="Posts" asp-action="Create" class="inline-flex items-center justify-center rounded-full bg-slate-950 text-white px-6 py-2.5 text-sm font-bold hover:bg-slate-800 transition-colors" dark:bg-white dark:text-black>
                    <i class="fa-solid fa-pen-to-square me-2"></i> Tạo bài viết
                </a>
            </div>
        </div>

        <!-- Right Sidebar -->
        <div class="w-full lg:w-1/3 space-y-6">
            <!-- About Card -->
            <div class="rounded-3xl border border-slate-100 bg-white shadow-card p-6" dark:border-white/10 dark:bg-black>
                <h3 class="font-heading font-bold text-slate-900 mb-4" dark:text-slate-100>Giới thiệu</h3>
                @if (!string.IsNullOrEmpty(Model.Bio))
                {
                    <p class="text-sm text-slate-700 mb-5 whitespace-pre-wrap leading-relaxed">@Model.Bio</p>
                }
                
                <div class="space-y-3.5 text-sm font-medium text-slate-600" dark:text-slate-400>
                    @if (!string.IsNullOrEmpty(Model.Location))
                    {
                        <div class="flex items-center gap-3">
                            <div class="w-8 h-8 rounded-full bg-slate-50 flex items-center justify-center text-slate-400" dark:bg-neutral-900>
                                <i class="fa-solid fa-location-dot"></i>
                            </div>
                            <span>@Model.Location</span>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.WebsiteUrl))
                    {
                        <div class="flex items-center gap-3">
                            <div class="w-8 h-8 rounded-full bg-slate-50 flex items-center justify-center text-slate-400" dark:bg-neutral-900>
                                <i class="fa-solid fa-link"></i>
                            </div>
                            <a href="@Model.WebsiteUrl" target="_blank" class="text-blue-600 hover:underline truncate">@Model.WebsiteUrl</a>
                        </div>
                    }
                    <div class="flex items-center gap-3">
                        <div class="w-8 h-8 rounded-full bg-slate-50 flex items-center justify-center text-slate-400" dark:bg-neutral-900>
                            <i class="fa-solid fa-envelope"></i>
                        </div>
                        <span class="truncate">@Model.Email</span>
                    </div>
                    <div class="flex items-center gap-3">
                        <div class="w-8 h-8 rounded-full bg-slate-50 flex items-center justify-center text-slate-400" dark:bg-neutral-900>
                            <i class="fa-solid fa-calendar-days"></i>
                        </div>
                        <span>Tham gia @Model.CreatedAt.ToLocalTime().ToString("MMM yyyy")</span>
                    </div>
                </div>
            </div>

            <!-- Friends Card -->
            <div class="rounded-3xl border border-slate-100 bg-white shadow-card p-6" dark:border-white/10 dark:bg-black>
                <div class="flex items-center justify-between mb-4">
                    <h3 class="font-heading font-bold text-slate-900" dark:text-slate-100>Bạn bè</h3>
                </div>
                <div id="profile-friends-list" class="space-y-2">
                    <p class="text-sm font-medium text-slate-500" dark:text-slate-400>Đang tải...</p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- POST MODAL STYLED WITH TAILWIND -->
<div id="postModalOverlay" class="fixed inset-0 z-[100] bg-slate-900/80 backdrop-blur-sm hidden items-center justify-center p-4 sm:p-6" aria-labelledby="modal-title" role="dialog" aria-modal="true">
    <div class="bg-white rounded-[2rem] shadow-2xl w-full max-w-2xl max-h-[90vh] overflow-hidden flex flex-col relative" dark:bg-black id="postModalContent">
        <div class="flex items-center justify-between p-5 border-b border-slate-100" dark:border-white/10>
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-full bg-gradient-to-br from-slate-900 to-slate-700 text-white font-bold flex items-center justify-center text-sm" id="postModalUserAvatar">U</div>
                <div>
                    <div class="font-bold text-slate-900 text-sm" dark:text-slate-100 id="postModalUserName">Người dùng</div>
                    <div class="text-xs font-medium text-slate-500" dark:text-slate-400 id="postModalCreatedAt"></div>
                </div>
            </div>
            <button type="button" id="closePostModal" class="text-slate-400 hover:text-slate-700 transition-colors w-8 h-8 flex items-center justify-center rounded-full hover:bg-slate-100" dark:hover:bg-white/10>
                <i class="fa-solid fa-xmark text-lg"></i>
            </button>
        </div>
        
        <div class="overflow-y-auto p-5 flex-grow custom-scrollbar">
            <div id="postModalMediaWrapper" class="mb-5 rounded-2xl overflow-hidden bg-slate-50" dark:bg-neutral-900></div>

            <div id="postModalCaptionWrapper" class="mb-5 hidden">
                <p id="postModalCaption" class="text-slate-800 text-[15px] leading-relaxed whitespace-pre-wrap" dark:text-slate-100></p>
            </div>

            <div class="flex items-center gap-5 text-sm font-bold text-slate-600 py-4 border-t border-slate-100" dark:text-slate-400 dark:border-white/10>
                <span class="flex items-center gap-2"><i class="fa-solid fa-heart text-slate-400"></i><span id="postModalLikes">0</span></span>
                <span class="flex items-center gap-2"><i class="fa-solid fa-comment text-slate-400"></i><span id="postModalCommentsCount">0</span></span>
            </div>

            <div class="border-t border-slate-100 pt-5" dark:border-white/10>
                <h4 class="font-bold text-sm text-slate-900 mb-4" dark:text-slate-100>Bình luận</h4>
                <div id="postModalCommentsList" class="space-y-4"></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const userId = @userId;
            const currentUserId = @userId;
            loadProfileStats(userId);
            loadProfilePosts(userId);
            loadFriends(userId);

            const modalOverlay = document.getElementById('postModalOverlay');
            const btnClose = document.getElementById('closePostModal');
            const content = document.getElementById('postModalContent');
            
            function closePostModal() {
                modalOverlay.classList.remove('flex');
                modalOverlay.classList.add('hidden');
                document.body.style.overflow = 'auto';
            }

            btnClose.addEventListener('click', closePostModal);
            modalOverlay.addEventListener('click', function(e) {
                if(!content.contains(e.target)) closePostModal();
            });
        });

        
        async function deleteComment(commentId, btn) {
            if(!confirm("Bạn có chắc chắn muốn xóa bình luận này?")) return;
            try {
                const res = await fetch(`/api/comments/${commentId}`, { method: "DELETE" });
                if(res.ok) {
                    btn.closest('.flex.gap-3').remove();
                } else {
                    alert("Không thể xóa bình luận.");
                }
            } catch(e) { console.error(e); }
        }
        
        async function deletePost(postId) {
            if(!confirm("Bạn có chắc chắn muốn xóa bài viết này?")) return;
            try {
                const res = await fetch(`/api/posts/${postId}`, { method: "DELETE" });
                if(res.ok) {
                    alert("Đã xóa bài viết.");
                    window.location.reload();
                } else {
                    alert("Lỗi khi xóa bài viết.");
                }
            } catch(e) { console.error(e); }
        }

        async function loadProfileStats(userId) {
            try {
                const [postsRes, friendsRes, incomingRes] = await Promise.all([
                    fetch(`/api/posts/user/${userId}?skip=0&take=100`, { headers: { "X-Requested-With": "XMLHttpRequest" } }),
                    fetch(`/api/users/${userId}/friends`, { headers: { "X-Requested-With": "XMLHttpRequest" } }),
                    fetch(`/api/users/me/friend-requests/incoming`, { headers: { "X-Requested-With": "XMLHttpRequest" } })
                ]);

                const posts = postsRes.ok ? await postsRes.json() : [];
                const friends = friendsRes.ok ? await friendsRes.json() : [];
                const incoming = incomingRes.ok ? await incomingRes.json() : [];

                document.getElementById("stat-posts").textContent = posts.length;
                document.getElementById("stat-friends").textContent = friends.length;
                document.getElementById("stat-requests").textContent = incoming.length;
            } catch (e) {
                console.error("loadProfileStats error", e);
            }
        }

        window.profilePosts = [];

        function createPostCard(p) {
            const card = document.createElement('div');
            card.className = "rounded-3xl border border-slate-100 bg-white shadow-card p-5 sm:p-6 cursor-pointer hover:border-slate-200 transition-colors";
            card.dataset.postId = p.id;
            card.addEventListener('click', () => openPostModal(p.id));

            const header = document.createElement('div');
            header.className = "flex items-center gap-3 mb-4";
            
            const avatar = document.createElement('div');
            avatar.className = "w-11 h-11 rounded-full bg-gradient-to-br from-slate-900 to-slate-700 text-white font-bold flex items-center justify-center text-sm shadow-sm";
            const uName = (p.user?.fullName || p.user?.email || "U").trim();
            avatar.textContent = uName[0].toUpperCase();
            
            const info = document.createElement('div');
            info.innerHTML = `<div class="font-bold text-slate-900 text-sm" dark:text-slate-100>${uName}</div>
                              <div class="text-[13px] font-medium text-slate-500" dark:text-slate-400>${new Date(p.createdAt).toLocaleDateString()}</div>`;
            header.appendChild(avatar);
            header.appendChild(info);
            card.appendChild(header);

            if (p.caption) {
                const cap = document.createElement('p');
                cap.className = "text-slate-800 text-[15px] leading-relaxed mb-4 line-clamp-3";
                cap.textContent = p.caption;
                card.appendChild(cap);
            }

            if (p.imageUrl) {
                const mediaWrap = document.createElement('div');
                mediaWrap.className = "rounded-2xl overflow-hidden bg-slate-50 mb-4 aspect-video sm:aspect-[4/3] relative flex justify-center border border-slate-100";
                const img = document.createElement('img');
                img.src = p.imageUrl;
                img.className = "w-full h-full object-cover";
                mediaWrap.appendChild(img);
                card.appendChild(mediaWrap);
            } else if (p.videoUrl) {
                const mediaWrap = document.createElement('div');
                mediaWrap.className = "rounded-2xl overflow-hidden bg-slate-950 mb-4 aspect-video relative flex justify-center border border-slate-100";
                const vid = document.createElement('video');
                vid.src = p.videoUrl;
                vid.className = "w-full h-full object-contain";
                vid.muted = true;
                mediaWrap.appendChild(vid);
                card.appendChild(mediaWrap);
            }

            const footer = document.createElement('div');
            footer.className = "flex items-center gap-6 text-sm font-bold text-slate-600 mt-2";
            footer.innerHTML = `
                <span class="flex items-center gap-2 hover:text-slate-900 transition-colors" dark:text-slate-100><i class="fa-solid fa-heart text-slate-400"></i> ${p.likesCount ?? 0}</span>
                <span class="flex items-center gap-2 hover:text-slate-900 transition-colors" dark:text-slate-100><i class="fa-regular fa-comment text-slate-400"></i> ${p.commentsCount ?? 0}</span>
            `;
            card.appendChild(footer);

            return card;
        }

        async function loadProfilePosts(userId) {
            const list = document.getElementById("profile-posts-list");
            const empty = document.getElementById("profile-posts-empty");
            if (!list || !empty) return;
            list.innerHTML = "";

            try {
                const res = await fetch(`/api/posts/user/${userId}?skip=0&take=100`, { headers: { "X-Requested-With": "XMLHttpRequest" } });
                if (!res.ok) throw new Error();
                const posts = await res.json();
                window.profilePosts = posts;

                if (!posts || posts.length === 0) {
                    empty.classList.remove("hidden");
                    return;
                }

                empty.classList.add("hidden");
                posts.forEach(p => list.appendChild(createPostCard(p)));
            } catch (e) {
                list.innerHTML = '<div class="text-center text-sm font-medium text-red-500 py-4">Lỗi khi tải bài viết.</div>';
            }
        }

        async function loadFriends(userId) {
            const container = document.getElementById("profile-friends-list");
            if (!container) return;

            try {
                const res = await fetch(`/api/users/${userId}/friends`, { headers: { "X-Requested-With": "XMLHttpRequest" } });
                if (!res.ok) throw new Error();
                const friends = await res.json();
                
                if (!friends || friends.length === 0) {
                    container.innerHTML = '<p class="text-sm font-medium text-slate-500" dark:text-slate-400>Chưa có người bạn nào.</p>';
                    return;
                }

                container.innerHTML = "";
                friends.slice(0, 6).forEach(f => {
                    const item = document.createElement("a");
                    item.href = `/Users/Details/${f.id}`;
                    item.className = "flex items-center gap-3 p-2 -mx-2 rounded-xl hover:bg-slate-50 transition-colors";

                    const avatar = document.createElement("div");
                    avatar.className = "w-10 h-10 rounded-full bg-gradient-to-br from-slate-900 to-slate-700 text-white font-bold flex items-center justify-center text-sm flex-shrink-0";
                    const name = (f.fullName || f.email || "U").trim();
                    avatar.textContent = name[0].toUpperCase();

                    const body = document.createElement("div");
                    body.className = "flex-grow min-w-0";
                    body.innerHTML = `
                        <div class="font-bold text-slate-900 text-sm truncate" dark:text-slate-100>${f.fullName || "Người dùng"}</div>
                        <div class="text-[13px] font-medium text-slate-500 truncate" dark:text-slate-400>${f.email}</div>
                    `;

                    item.appendChild(avatar);
                    item.appendChild(body);
                    container.appendChild(item);
                });
                if(friends.length > 6) {
                    const more = document.createElement('div');
                    more.className = "text-center pt-3";
                    more.innerHTML = `<a href="#" class="text-sm font-bold text-slate-900 hover:text-slate-700 transition-colors" dark:text-slate-100>Xem tất cả ${friends.length} bạn bè</a>`;
                    container.appendChild(more);
                }
            } catch (e) {
                container.innerHTML = '<p class="text-sm font-medium text-red-500">Lỗi khi tải danh sách.</p>';
            }
        }

        async function openPostModal(postId) {
            const post = (window.profilePosts || []).find(p => p.id === postId);
            if (!post) return;

            const userName = (post.user?.fullName || post.user?.email || "Người dùng").trim();
            document.getElementById("postModalUserName").textContent = userName;
            
            const avatarEl = document.getElementById("postModalUserAvatar");
            if (post.user?.avatarUrl) {
                avatarEl.innerHTML = `<img src="${post.user.avatarUrl}" class="w-full h-full rounded-full object-cover" />`;
            } else {
                avatarEl.textContent = userName ? userName[0].toUpperCase() : "U";
            }
            
            const createdAtEl = document.getElementById("postModalCreatedAt");
            createdAtEl.textContent = post.createdAt ? new Date(post.createdAt).toLocaleString() : "";

            const captionWrapper = document.getElementById("postModalCaptionWrapper");
            const captionEl = document.getElementById("postModalCaption");
            if (post.caption && post.caption.trim().length > 0) {
                captionEl.textContent = post.caption;
                captionWrapper.classList.remove("hidden");
            } else {
                captionWrapper.classList.add("hidden");
            }

            document.getElementById("postModalLikes").textContent = post.likesCount ?? 0;
            document.getElementById("postModalCommentsCount").textContent = post.commentsCount ?? 0;

            const mediaWrapper = document.getElementById("postModalMediaWrapper");
            mediaWrapper.innerHTML = "";
            if (post.imageUrl) {
                mediaWrapper.innerHTML = `<img src="${post.imageUrl}" class="w-full h-auto max-h-[50vh] object-contain bg-slate-950" />`;
            } else if (post.videoUrl) {
                mediaWrapper.innerHTML = `<video src="${post.videoUrl}" class="w-full h-auto max-h-[50vh] bg-slate-950" controls preload="metadata"></video>`;
            }

            await loadPostModalComments(postId);

            const modalOverlay = document.getElementById('postModalOverlay');
            modalOverlay.classList.remove('hidden');
            modalOverlay.classList.add('flex');
            document.body.style.overflow = 'hidden';
        }

        async function loadPostModalComments(postId) {
            const list = document.getElementById("postModalCommentsList");
            if (!list) return;
            list.innerHTML = '<p class="text-sm font-medium text-slate-500" dark:text-slate-400>Đang tải...</p>';

            try {
                const res = await fetch(`/api/comments/post/${postId}`, { headers: { "X-Requested-With": "XMLHttpRequest" } });
                if (!res.ok) throw new Error();
                const comments = await res.json();
                list.innerHTML = "";

                if (!comments || comments.length === 0) {
                    list.innerHTML = '<p class="text-sm font-medium text-slate-500" dark:text-slate-400>Chưa có bình luận nào.</p>';
                    return;
                }

                comments.forEach(c => {
                    const item = document.createElement("div");
                    item.className = "flex gap-3";

                    const name = (c.user?.fullName || c.user?.email || "Người dùng").trim();
                    const avatarHtml = c.user?.avatarUrl
                        ? `<img src="${c.user.avatarUrl}" class="w-9 h-9 rounded-full object-cover flex-shrink-0 shadow-sm" />`
                        : `<div class="w-9 h-9 rounded-full bg-gradient-to-br from-slate-900 to-slate-700 text-white font-bold flex flex-shrink-0 items-center justify-center text-xs shadow-sm">${name[0].toUpperCase()}</div>`;
                        
                    item.innerHTML = `
                        ${avatarHtml}
                        <div class="flex-grow bg-slate-50/80 p-3.5 rounded-2xl rounded-tl-none border border-slate-100" dark:border-white/10 dark:bg-neutral-900>
                            <div class="flex items-center justify-between mb-1.5">
                                <span class="font-bold text-slate-900 text-sm" dark:text-slate-100>${name}</span>
                                <div class="flex items-center gap-2">
                                    <span class="text-[11px] font-medium text-slate-500" dark:text-slate-400>${c.createdAt ? new Date(c.createdAt).toLocaleDateString() : ""}</span>
                                    ${c.userId === currentUserId ? `<button onclick="deleteComment(${c.id}, this)" class="text-slate-400 hover:text-red-500 transition"><i class="fa-solid fa-trash text-xs"></i></button>` : ''}
                                </div>
                            </div>
                            <div class="text-slate-700 text-[14px] leading-relaxed whitespace-pre-wrap">${c.content || ""}</div>
                        </div>
                    `;
                    list.appendChild(item);
                });
            } catch (e) {
                list.innerHTML = '<p class="text-sm font-medium text-red-500">Lỗi khi tải bình luận.</p>';
            }
        }
    </script>
}
