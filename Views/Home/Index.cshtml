@using System.Security.Claims
@{
    ViewData["Title"] = "Trang chủ";
    var isAuthenticated = User.Identity?.IsAuthenticated ?? false;
}

<div class="relative overflow-hidden bg-slate-50 min-h-screen" dark:bg-slate-950>
    <!-- BACKGROUND EFFECTS -->
    <div class="absolute inset-0 z-0">
        <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-7xl h-[500px] bg-gradient-to-b from-blue-500/10 to-transparent blur-3xl rounded-full opacity-50" dark:from-blue-500/5></div>
    </div>

    <div class="relative z-10 mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8 lg:py-32">
        <!-- HERO SECTION -->
        <div class="text-center max-w-4xl mx-auto">
            
            <h1 class="text-4xl font-extrabold tracking-tight text-slate-950 sm:text-5xl lg:text-6xl font-heading leading-[1.1]" dark:text-slate-100>
                Kết nối mạng lưới, chia sẻ <span class="bg-gradient-to-r from-blue-600 to-indigo-600 bg-clip-text text-transparent">khoảnh khắc</span>
            </h1>
            
            <p class="mt-6 text-lg sm:text-xl text-slate-600 leading-relaxed max-w-2xl mx-auto" dark:text-slate-400>
                Mạng xã hội thế hệ mới giúp bạn kết nối với bạn bè, chia sẻ những khoảnh khắc đáng nhớ và khám phá thế giới xung quanh.
            </p>

            <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
                @if (!isAuthenticated)
                {
                    <a asp-controller="Account" asp-action="Register" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 rounded-full bg-slate-950 px-8 py-4 text-sm font-bold text-white hover:bg-slate-800 transition-all shadow-xl hover:shadow-2xl active:scale-95" dark:bg-white dark:text-black dark:hover:bg-slate-200>
                        Bắt đầu ngay <i class="fa-solid fa-arrow-right"></i>
                    </a>
                    <a asp-controller="Account" asp-action="Login" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 rounded-full bg-white border border-slate-200 px-8 py-4 text-sm font-bold text-slate-900 hover:bg-slate-50 transition-all active:scale-95" dark:bg-black dark:border-white/20 dark:text-white dark:hover:bg-white/5>
                        Đăng nhập
                    </a>
                }
                else
                {
                    <a asp-controller="Posts" asp-action="Feed" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 rounded-full bg-slate-950 px-8 py-4 text-sm font-bold text-white hover:bg-slate-800 transition-all shadow-xl hover:shadow-2xl active:scale-95" dark:bg-white dark:text-black dark:hover:bg-slate-200>
                        Đi tới Bảng tin <i class="fa-solid fa-arrow-right"></i>
                    </a>
                }
            </div>
        </div>

        <!-- FEATURES SECTION -->
        <div class="mt-32">
            <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
                <div class="group rounded-3xl border border-slate-200/80 bg-white p-7 shadow-card transition-all duration-300 hover:-translate-y-1 hover:border-slate-300 hover:shadow-lift" dark:border-white/10 dark:bg-black>
                    <div class="mb-6 flex h-14 w-14 items-center justify-center rounded-2xl bg-blue-50 text-blue-600 transition-all group-hover:bg-slate-950 group-hover:text-white" dark:bg-white dark:text-black>
                        <i class="fa-solid fa-newspaper text-xl"></i>
                    </div>
                    <h3 class="mb-2 text-xl font-bold tracking-tight text-slate-900 font-heading" dark:text-slate-100>Bảng tin Realtime</h3>
                    <p class="text-sm font-medium leading-relaxed text-slate-500" dark:text-slate-400>Khám phá bài viết, ảnh, video với tương tác like và comment tức thì qua SignalR.</p>
                </div>
                <div class="group rounded-3xl border border-slate-200/80 bg-white p-7 shadow-card transition-all duration-300 hover:-translate-y-1 hover:border-slate-300 hover:shadow-lift sm:mt-8" dark:border-white/10 dark:bg-black>
                    <div class="mb-6 flex h-14 w-14 items-center justify-center rounded-2xl bg-emerald-50 text-emerald-600 transition-all group-hover:bg-slate-950 group-hover:text-white" dark:bg-white dark:text-black>
                        <i class="fa-solid fa-user-group text-xl"></i>
                    </div>
                    <h3 class="mb-2 text-xl font-bold tracking-tight text-slate-900 font-heading" dark:text-slate-100>Mạng lưới kết nối</h3>
                    <p class="text-sm font-medium leading-relaxed text-slate-500" dark:text-slate-400>Tìm kiếm bạn bè, theo dõi người dùng và xây dựng cộng đồng gắn kết chất lượng.</p>
                </div>
                <div class="group rounded-3xl border border-slate-200/80 bg-white p-7 shadow-card transition-all duration-300 hover:-translate-y-1 hover:border-slate-300 hover:shadow-lift" dark:border-white/10 dark:bg-black>
                    <div class="mb-6 flex h-14 w-14 items-center justify-center rounded-2xl bg-indigo-50 text-indigo-600 transition-all group-hover:bg-slate-950 group-hover:text-white" dark:bg-white dark:text-black>
                        <i class="fa-regular fa-comment-dots text-xl"></i>
                    </div>
                    <h3 class="mb-2 text-xl font-bold tracking-tight text-slate-900 font-heading" dark:text-slate-100>Chat Popup nổi</h3>
                    <p class="text-sm font-medium leading-relaxed text-slate-500" dark:text-slate-400>Nhắn tin trực tiếp ngay trên trang với cửa sổ chat tiện lợi phong cách hiện đại.</p>
                </div>
                <div class="group rounded-3xl border border-slate-200/80 bg-white p-7 shadow-card transition-all duration-300 hover:-translate-y-1 hover:border-slate-300 hover:shadow-lift sm:mt-8" dark:border-white/10 dark:bg-black>
                    <div class="mb-6 flex h-14 w-14 items-center justify-center rounded-2xl bg-violet-50 text-violet-600 transition-all group-hover:bg-slate-950 group-hover:text-white" dark:bg-white dark:text-black>
                        <i class="fa-solid fa-video text-xl"></i>
                    </div>
                    <h3 class="mb-2 text-xl font-bold tracking-tight text-slate-900 font-heading" dark:text-slate-100>Gọi thoại & Video</h3>
                    <p class="text-sm font-medium leading-relaxed text-slate-500" dark:text-slate-400>Thực hiện cuộc gọi trực tiếp WebRTC mượt mà với âm thanh và hình ảnh sắc nét.</p>
                </div>
            </div>
        </div>

        <!-- PLATFORM PREVIEW SECTION -->
        <section class="mt-24 sm:mt-32 overflow-hidden rounded-[32px] border border-slate-200/80 bg-white p-4 shadow-lift" dark:border-white/10 dark:bg-black>
            <div class="relative overflow-hidden rounded-2xl bg-slate-950 px-6 py-12 sm:px-12 sm:py-16 text-white text-center" dark:bg-white dark:text-black>
                <div class="max-w-2xl mx-auto space-y-4">
                    <h2 class="text-2xl sm:text-3xl font-bold font-heading">Sẵn sàng trải nghiệm Okem?</h2>
                    <p class="text-sm sm:text-base text-slate-300 leading-relaxed">
                        Tham gia ngay cùng hàng ngàn thành viên khác để bắt đầu chia sẻ câu chuyện và mở rộng vòng kết nối của bạn.
                    </p>
                    <div class="pt-4 flex justify-center gap-4">
                        @if (!isAuthenticated)
                        {
                            <a asp-controller="Account" asp-action="Register"
                               class="inline-flex items-center gap-2 rounded-full bg-white px-8 py-3 text-sm font-bold text-slate-950 hover:bg-slate-100 transition-all active:scale-95" dark:hover:bg-white/10 dark:text-slate-100 dark:bg-black>
                                <span>Tạo tài khoản miễn phí</span>
                                <i class="fa-solid fa-arrow-right text-xs"></i>
                            </a>
                        }
                        else
                        {
                            <a asp-controller="Posts" asp-action="Feed"
                               class="inline-flex items-center gap-2 rounded-full bg-white px-8 py-3 text-sm font-bold text-slate-950 hover:bg-slate-100 transition-all active:scale-95" dark:hover:bg-white/10 dark:text-slate-100 dark:bg-black>
                                <span>Đi tới Bảng tin</span>
                                <i class="fa-solid fa-arrow-right text-xs"></i>
                            </a>
                        }
                    </div>
                </div>
            </div>
        </section>

        <!-- METRICS SECTION (From Benchmark) -->
        <section class="mt-24 sm:mt-32 grid grid-cols-2 gap-8 border-t border-slate-200 pt-16 md:grid-cols-4" dark:border-white/10>
            <div class="flex flex-col items-center text-center">
                <span class="text-4xl sm:text-5xl font-black text-slate-950 font-heading" dark:text-slate-100>1k+</span>
                <span class="mt-3 text-xs font-bold uppercase tracking-widest text-blue-600">CCU Kết nối (Local)</span>
            </div>
            <div class="flex flex-col items-center text-center">
                <span class="text-4xl sm:text-5xl font-black text-slate-950 font-heading" dark:text-slate-100>5.6k+</span>
                <span class="mt-3 text-xs font-bold uppercase tracking-widest text-blue-600">Request / Giây (RPS)</span>
            </div>
            <div class="flex flex-col items-center text-center">
                <span class="text-4xl sm:text-5xl font-black text-slate-950 font-heading" dark:text-slate-100>170+</span>
                <span class="mt-3 text-xs font-bold uppercase tracking-widest text-blue-600">MB/s Throughput</span>
            </div>
            <div class="flex flex-col items-center text-center">
                <span class="text-4xl sm:text-5xl font-black text-slate-950 font-heading" dark:text-slate-100>20ms</span>
                <span class="mt-3 text-xs font-bold uppercase tracking-widest text-blue-600">Avg Latency</span>
            </div>
        </section>
        
        <div class="mt-8 text-center">
            <p class="text-xs text-slate-400 font-medium italic dark:text-slate-500">
                * Dữ liệu benchmark thực tế được đo lường bằng Autocannon trên môi trường Local: CPU 13th Gen Intel Core i5-1335U, 24GB RAM, Windows 11.
            </p>
        </div>
    </div>
</div>
